---
import Layout from '../../layouts/Layout.astro';
import {
  buildAllWeeks,
  buildWeekArticles,
  pickFeature,
  getTeamTopic,
  cardTitle,
  weekTheme,
  type Article,
} from '../../lib/data';

export function getStaticPaths() {
  const weeks = buildAllWeeks().filter((w) => w.submittedCount > 0);
  return weeks.map((w) => ({
    params: { week: String(w.weekNumber) },
    props: { weekNumber: w.weekNumber },
  }));
}

const { weekNumber } = Astro.props as { weekNumber: number };

const weeks = buildAllWeeks().filter((w) => w.submittedCount > 0);
const idx = weeks.findIndex((w) => w.weekNumber === weekNumber);
const week = weeks[idx];
const prev = idx > 0 ? weeks[idx - 1] : null;
const next = idx < weeks.length - 1 ? weeks[idx + 1] : null;

const articles = buildWeekArticles(week);
const feature = pickFeature(articles);

const TEAMS = ['1조', '2조', '3조', '4조', '5조', '6조'];
const byTeam = new Map<string, Article[]>();
for (const a of articles) {
  if (a === feature) continue;
  const arr = byTeam.get(a.member.team) ?? [];
  arr.push(a);
  byTeam.set(a.member.team, arr);
}

const theme = weekTheme(articles);
const weekLabel = (n: number) => `WEEK ${String(n).padStart(2, '0')}`;
const rate =
  week.totalMembers > 0
    ? Math.round((week.submittedCount / week.totalMembers) * 100)
    : 0;
---

<Layout
  title={`${weekLabel(weekNumber)} · ${weekNumber}주차 — 스폰지클럽`}
  description={`스폰지클럽 ${weekNumber}주차 — ${articles.length}명의 기록.`}
  bodyClass="sc-page"
>
  <header class="sc-header">
    <div class="sc-header-inner">
      <a href="/" class="sc-brand">
        <span class="sc-brand-mark">🧽</span>
        <span class="sc-brand-name">spongeclub</span>
        <span class="sc-brand-sep">/</span>
        <span class="sc-brand-sub">{weekLabel(weekNumber)}</span>
      </a>
      <nav class="sc-nav" aria-label="메인 메뉴">
        <a href="/">매거진</a>
        <a href="/board/">현황판</a>
        <a href="/keywords/">키워드</a>
        <a href="/skills/">스킬</a>
        <a href="/gallery/">갤러리</a>
      </nav>
      <span class="sc-week-pill">{weekLabel(weekNumber)}</span>
    </div>
  </header>

  <main class="sc-main">
    <!-- 표지 -->
    <section class="iss-cover">
      <p class="iss-cover-vol">{weekLabel(weekNumber)} · {weekNumber}주차{week.dateLabel ? ` · ${week.dateLabel}` : ''}</p>
      <h1 class="iss-cover-title">
        <span class="sc-shape sc-shape--square" aria-hidden="true"></span>
        <span>{theme || `${weekNumber}주차의 기록`}</span>
      </h1>
      <p class="iss-cover-sub">{articles.length}명이 각자의 방식으로 이번 주를 기록했어요.</p>
      <div class="iss-cover-stats">
        <span><b>{articles.length}</b> 기록</span>
        <span class="iss-cover-sep">·</span>
        <span><b>{week.submittedCount}</b> / {week.totalMembers} 제출</span>
        <span class="iss-cover-sep">·</span>
        <span><b>{rate}%</b></span>
      </div>
    </section>

    {feature && (
      <article class="iss-feature">
        <div class="iss-feature-side">
          <span class="iss-feature-tag">★ 이번 호 주요 기사</span>
          <span class="iss-feature-team">{feature.member.team}</span>
          <span class="iss-feature-name">
            글 · <a href={`/member/${encodeURIComponent(feature.member.team)}/${encodeURIComponent(feature.member.nickname)}/`}><b>{feature.member.nickname}</b></a>
          </span>
        </div>
        <div class="iss-feature-main">
          <h2 class="iss-feature-title">{cardTitle(feature)}</h2>
          <p class="iss-feature-excerpt">{feature.excerpt}</p>
          <a class="iss-feature-cta" href={feature.url}>전체 기록 읽기 →</a>
        </div>
      </article>
    )}

    {articles.length === 0 && (
      <div class="iss-empty">이 호에는 아직 제출된 기록이 없습니다.</div>
    )}

    <!-- 조별 -->
    {TEAMS.map((team) => {
      const list = byTeam.get(team) ?? [];
      if (list.length === 0) return null;
      const topic = getTeamTopic(team);
      return (
        <section class="iss-team">
          <header class="iss-team-bar">
            <span class="iss-team-name">{team}</span>
            {topic && <span class="iss-team-topic">{topic.topic}</span>}
            <span class="iss-team-count">{list.length}개 기록</span>
          </header>
          <div class="iss-articles">
            {list.map((a) => (
              <a class="iss-article" href={a.url}>
                <span class="iss-article-by"><b>{a.member.nickname}</b>{a.member.isCrew ? ' · 크루' : ''}</span>
                <h3 class="iss-article-title">{cardTitle(a)}</h3>
                {a.missions.filter((m) => m.title).slice(1, 4).length > 0 && (
                  <div class="iss-article-missions">
                    {a.missions.filter((m) => m.title).slice(1, 4).map((m) => (
                      <span class="iss-article-chip">+ {m.title}</span>
                    ))}
                  </div>
                )}
                <p class="iss-article-excerpt">{a.excerpt}</p>
                <span class="iss-article-read">읽기 →</span>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    <!-- 이슈 이동 -->
    <nav class="iss-nav">
      {prev ? (
        <a href={`/issue/${prev.weekNumber}/`} class="iss-nav-link">
          <span class="iss-nav-label">← 지난 호</span>
          <span class="iss-nav-vol">{weekLabel(prev.weekNumber)} · {prev.weekNumber}주차</span>
        </a>
      ) : <span></span>}
      {next ? (
        <a href={`/issue/${next.weekNumber}/`} class="iss-nav-link iss-nav-link--next">
          <span class="iss-nav-label">다음 호 →</span>
          <span class="iss-nav-vol">{weekLabel(next.weekNumber)} · {next.weekNumber}주차</span>
        </a>
      ) : <span></span>}
    </nav>
  </main>

  <footer class="sc-footer">
    스폰지클럽 · {weekLabel(weekNumber)}
  </footer>
</Layout>

<style is:global>
  /* 표지 */
  .iss-cover { display: flex; flex-direction: column; gap: 14px; }
  .iss-cover-vol {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--sc-accent-red);
  }
  .iss-cover-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(48px, 7vw, 96px);
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--sc-text-primary);
    display: flex; flex-direction: column; gap: 18px; align-items: flex-start;
  }
  .iss-cover-sub {
    font-size: 16px;
    font-weight: 500;
    color: var(--sc-text-muted-high);
    max-width: 640px;
  }
  .iss-cover-stats {
    display: flex; flex-wrap: wrap; gap: 14px;
    margin-top: 10px;
    font-size: 14px;
    color: var(--sc-text-muted-mid);
  }
  .iss-cover-stats b { color: var(--sc-text-primary); font-weight: 700; }
  .iss-cover-sep { color: var(--sc-text-muted-low); }

  /* 주요 기사 */
  .iss-feature {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    overflow: hidden;
  }
  .iss-feature-side {
    padding: clamp(24px, 3vw, 36px);
    background: var(--sc-surface-dark);
    color: var(--sc-text-on-dark);
    display: flex; flex-direction: column; gap: 14px;
    border-right: 1px solid var(--sc-border-card);
  }
  .iss-feature-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--sc-bg-signature);
    color: var(--sc-text-primary);
    border-radius: var(--sc-radius-pill);
    padding: 5px 11px;
    align-self: flex-start;
  }
  .iss-feature-team {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(36px, 4.4vw, 60px);
    line-height: 0.95;
    color: var(--sc-bg-signature);
  }
  .iss-feature-name {
    margin-top: auto;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 230, 122, 0.85);
  }
  .iss-feature-name b { color: var(--sc-bg-signature); font-weight: 700; }
  .iss-feature-name a { border-bottom: 1px solid rgba(255, 230, 122, 0.35); }
  .iss-feature-main {
    padding: clamp(24px, 3vw, 36px);
    display: flex; flex-direction: column; gap: 14px;
  }
  .iss-feature-title {
    font-family: var(--sc-font-body);
    font-weight: 700;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--sc-text-primary);
  }
  .iss-feature-excerpt {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--sc-text-muted-high);
    font-weight: 500;
  }
  .iss-feature-cta {
    align-self: flex-start;
    margin-top: 4px;
    padding: 10px 18px;
    border-radius: var(--sc-radius-pill);
    background: var(--sc-text-primary);
    color: var(--sc-bg-signature);
    font-weight: 700;
    font-size: 13px;
    transition: filter 140ms, transform 140ms;
  }
  .iss-feature-cta:hover { filter: brightness(1.1); transform: translateY(-1px); }
  @media (max-width: 760px) { .iss-feature { grid-template-columns: 1fr; } .iss-feature-side { border-right: none; border-bottom: 1px solid var(--sc-border-card); } }

  .iss-empty {
    padding: 60px 24px;
    text-align: center;
    color: var(--sc-text-muted-mid);
    border: 1px dashed var(--sc-border-card);
    border-radius: var(--sc-radius-card);
  }

  /* 조별 */
  .iss-team { display: flex; flex-direction: column; gap: 16px; }
  .iss-team-bar {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    padding: 14px 18px;
    background: var(--sc-surface-dark);
    color: var(--sc-text-on-dark);
    border-radius: var(--sc-radius-card);
  }
  .iss-team-name {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 28px;
    color: var(--sc-bg-signature);
    line-height: 1;
  }
  .iss-team-topic { font-size: 13px; font-weight: 500; opacity: 0.85; }
  .iss-team-count {
    margin-left: auto;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: var(--sc-radius-pill);
    background: var(--sc-bg-signature);
    color: var(--sc-text-primary);
  }
  .iss-articles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 12px;
  }
  .iss-article {
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    padding: 18px 20px;
    display: flex; flex-direction: column; gap: 10px;
    transition: transform 160ms, box-shadow 160ms, border-color 160ms;
  }
  .iss-article:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(26, 31, 54, 0.07);
    border-color: var(--sc-accent-red);
  }
  .iss-article-by { font-size: 11px; font-weight: 500; color: var(--sc-text-muted-mid); }
  .iss-article-by b { color: var(--sc-text-primary); font-weight: 700; }
  .iss-article-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 22px;
    line-height: 1.2;
    color: var(--sc-text-primary);
  }
  .iss-article-missions { display: flex; flex-wrap: wrap; gap: 5px; }
  .iss-article-chip {
    font-size: 10px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(26, 31, 54, 0.06);
    color: var(--sc-text-muted-high);
  }
  .iss-article-excerpt {
    font-size: 13px;
    line-height: 1.6;
    color: var(--sc-text-muted-high);
    font-weight: 500;
  }
  .iss-article-read {
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid var(--sc-border-soft);
    font-size: 11px;
    font-weight: 700;
    color: var(--sc-accent-red);
    letter-spacing: 0.04em;
  }

  /* nav */
  .iss-nav {
    display: flex; justify-content: space-between; gap: 12px;
    padding-top: 28px;
    border-top: 1px solid var(--sc-border-soft);
  }
  .iss-nav-link {
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    padding: 14px 18px;
    display: flex; flex-direction: column; gap: 4px;
    transition: transform 140ms, border-color 140ms;
  }
  .iss-nav-link:hover { transform: translateY(-2px); border-color: var(--sc-text-primary); }
  .iss-nav-link--next { text-align: right; }
  .iss-nav-label { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: var(--sc-accent-red); }
  .iss-nav-vol { font-size: 13px; font-weight: 600; color: var(--sc-text-primary); }
</style>
