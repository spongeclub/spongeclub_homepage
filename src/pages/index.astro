---
import Layout from '../layouts/Layout.astro';
import {
  buildAllWeeks,
  buildWeekArticles,
  buildArticle,
  pickFeature,
  cardTitle,
  weekTheme,
  loadTeamAnalyses,
} from '../lib/data';
import { loadCuratedSkills, getLatestSkills } from '../lib/curated-skills';

// 발행된 호 = 제출 기록이 1건 이상 있는 주차만
const weeks = buildAllWeeks().filter((w) => w.submittedCount > 0);
const hasData = weeks.length > 0;
const latest = hasData ? weeks[weeks.length - 1] : null;

const totalWeeks = weeks.length;
const totalMembers = latest ? latest.totalMembers : 0;
const totalSubmissions = weeks.reduce((sum, w) => sum + w.submittedCount, 0);

const latestArticles = latest ? buildWeekArticles(latest) : [];
const feature = pickFeature(latestArticles);
const sideArticles = latestArticles.filter((a) => a !== feature).slice(0, 4);

const pastIssues = [...weeks].reverse().map((w) => {
  const arts = buildWeekArticles(w);
  return { week: w, theme: weekTheme(arts), count: arts.length };
});

// 신규 등록 스킬 TOP 3 (skill md `created` 기준 최신)
const latestSkills = getLatestSkills(loadCuratedSkills(), 3);

// 이번 주 MVP — submit.md frontmatter `mvp: true` 기준
const teamOrder = ['1조', '2조', '3조', '4조', '5조', '6조'];
const mvpSubmissions = latest
  ? latest.submissions.filter((s) => s.mvp && s.filePath)
  : [];
const weeklyMvps = teamOrder.map((team) => {
  const sub = mvpSubmissions.find((s) => s.member.team === team);
  if (!sub || !latest) return { team, nickname: '미정', title: '이번 주 미정', excerpt: '', reason: '', url: '#' };
  const art = buildArticle(sub, latest.weekNumber);
  return {
    team,
    nickname: sub.member.nickname,
    title: art ? cardTitle(art) : (sub.noteTitle || ''),
    excerpt: art ? (art.excerpt || '').slice(0, 90) : '',
    reason: sub.mvpReason || '',
    url: art?.url || '#',
  };
});

// 조별 분석 카드 — 90_analysis/teams/Week_0N_조M.md 에서 로드
const teamAnalyses = latest ? loadTeamAnalyses(latest.weekNumber) : [];
const teamCards = teamOrder.map((team) => {
  const a = teamAnalyses.find((x) => x.team === team);
  if (a) return { team, theme: a.theme, summary: a.summary, insight: a.insight };
  return {
    team,
    theme: `${latest?.weekNumber ?? ''}주차의 기록`,
    summary: '아직 분석이 생성되지 않았습니다.',
    insight: '',
  };
});

const vol = (n: number) => `VOL.${String(n).padStart(2, '0')}`;
const year = new Date().getFullYear();
---

<Layout title="스폰지클럽 — 매주 만들고, 각자 나눈다" bodyClass="mag">
  <!-- ═══ NAV ═══ -->
  <nav class="nav">
    <div class="wrap nav-inner">
      <a href="/" class="brand">
        <span class="brand-shapes" aria-hidden="true">
          <span class="s-c"></span>
          <span class="s-s"></span>
          <span class="s-t"></span>
        </span>
        <span>스폰지클럽</span>
      </a>
      <div class="nav-links">
        <a href="#about">소개</a>
        <a href="#this-issue">이번 호</a>
        <a href="/keywords/">키워드</a>
        <a href="/skills/">스킬모음</a>
        <a href="/gallery/">갤러리</a>
      </div>
      {latest && <span class="nav-vol">{vol(latest.weekNumber)}</span>}
    </div>
  </nav>

  <main class="wrap">
    {!hasData && (
      <section class="hero">
        <h1 class="hero-title">스폰지클럽</h1>
        <p class="hero-lede">아직 발행된 호가 없습니다.</p>
      </section>
    )}

    {hasData && (
      <>
        <!-- ═══ HERO / 소개 ═══ -->
        <section class="hero" id="about">
          <div class="hero-deco" aria-hidden="true">
            <span class="d-c"></span>
            <span class="d-s"></span>
          </div>
          <div class="hero-kicker reveal d1">
            <span>스폰지클럽 — <b>매주 만들고, 각자 나눈다</b></span>
            <span>{latest && vol(latest.weekNumber)} · {year}</span>
          </div>
          <h1 class="hero-title reveal d2">
            매주 만들고,<br />
            <em>각자</em> 나눈다.
          </h1>
          <p class="hero-lede reveal d3">
            {totalMembers}명이 매주 무언가를 만들고, 그 과정을 기록하는 AI 빌더 커뮤니티.<br />
            이 페이지는 매주 한 호씩 발행되는 그 기록입니다.
          </p>
          <div class="hero-stats reveal d4">
            <div>
              <div class="n">{String(totalWeeks).padStart(2, '0')}</div>
              <div class="l">발행 호 / Issues</div>
            </div>
            <div>
              <div class="n">{totalMembers}</div>
              <div class="l">멤버 / Members</div>
            </div>
            <div>
              <div class="n">{totalSubmissions}</div>
              <div class="l">누적 기록 / Records</div>
            </div>
            <div>
              <div class="n">06</div>
              <div class="l">조 / Teams</div>
            </div>
          </div>
        </section>

        <!-- ═══ 이번 주 MVP ═══ -->
        <section class="s" id="mvp">
          <div class="s-head">
            <div>
              <div class="s-num">{latest && vol(latest.weekNumber)} — MVP</div>
              <h2 class="s-title">이번 주 <em>MVP</em></h2>
            </div>
            <p class="s-desc">
              6개 조에서 한 명씩 — 이번 호의 6인.
            </p>
          </div>
          <div class="mvp-grid">
            {weeklyMvps.map((m) => (
              <a class="mvp-card" href={m.url}>
                <div class="mvp-team">{m.team}</div>
                <div class="mvp-name">{m.nickname}</div>
                <div class="mvp-title">{m.title}</div>
                {m.reason && <div class="mvp-reason">★ {m.reason}</div>}
              </a>
            ))}
          </div>
        </section>

        <!-- ═══ 신규 등록 스킬 TOP 3 ═══ -->
        {latestSkills.length > 0 && (
          <section class="s" id="new-skills">
            <div class="s-head">
              <div>
                <div class="s-num">NEW DROP</div>
                <h2 class="s-title">방금 등록된 <em>스킬</em></h2>
              </div>
              <p class="s-desc">
                이번 주 새로 들어온 스킬 후기 — 따끈할 때 보세요.
              </p>
            </div>
            <div class="skills-top3">
              {latestSkills.map((sk) => (
                <a class="skill-card" href={`/skills/#${sk.slug}`}>
                  <div class="skill-meta">
                    <span class="sk-cat">{sk.category}</span>
                    {sk.created && <span class="sk-date">{sk.created}</span>}
                  </div>
                  <div class="skill-name">{sk.skillName || sk.title}</div>
                  <div class="skill-summary">{sk.summary}</div>
                  <div class="skill-foot">
                    {sk.userCount > 0 && <span>🔥 {sk.userCount}명이 써봄</span>}
                  </div>
                </a>
              ))}
            </div>
            <div class="skills-more">
              <a class="more-cta" href="/skills/">스킬모음 전체 보기 →</a>
            </div>
          </section>
        )}

        <!-- ═══ 이번 호 ═══ -->
        {latest && (
          <section class="s" id="this-issue">
            <div class="s-head">
              <div>
                <div class="s-num">{vol(latest.weekNumber)} — 이번 호</div>
                <h2 class="s-title">{latest.weekNumber}주차의 <em>기록</em></h2>
              </div>
              <p class="s-desc">
                {latestArticles.length}명이 이번 주 만든 것을 기록했다.
                전체는 이슈 페이지에서.
              </p>
            </div>

            <div class="team-grid">
              {teamCards.map((t) => (
                <article class="team-card">
                  <div class="tc-head">
                    <span class="tc-team">{t.team}</span>
                    <span class="tc-theme">{t.theme}</span>
                  </div>
                  <div class="tc-body">
                    <div class="tc-section">
                      <div class="tc-label">요약</div>
                      <p class="tc-text">{t.summary}</p>
                    </div>
                    <div class="tc-section tc-insight">
                      <div class="tc-label">★ 클로드 인사이트</div>
                      <p class="tc-text">{t.insight}</p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
            <div class="issue-cta-row">
              <a class="more-cta" href={`/issue/${latest.weekNumber}/`}>
                이번 호 전체 기록 보기 →
              </a>
            </div>
          </section>
        )}

        <!-- ═══ 지난 호 ═══ -->
        <section class="s" id="archive">
          <div class="s-head">
            <div>
              <div class="s-num">아카이브</div>
              <h2 class="s-title">지난 <em>호</em></h2>
            </div>
            <p class="s-desc">
              매주 한 호씩. 한 호를 열면 그 주의 모든 기록이 조별로 펼쳐진다.
            </p>
          </div>
          <div class="issue-grid">
            {pastIssues.map(({ week, theme, count }) => (
              <a class="issue-card" href={`/issue/${week.weekNumber}/`}>
                <span class="ic-vol">{vol(week.weekNumber)}</span>
                <span class="ic-title">
                  {theme || `${week.weekNumber}주차의 기록`}
                </span>
                <span class="ic-meta">
                  {count}개 기록{week.dateLabel ? ` · ${week.dateLabel}` : ''}
                </span>
              </a>
            ))}
          </div>
        </section>
      </>
    )}
  </main>

  <!-- ═══ FOOTER ═══ -->
  <footer class="mag-footer">
    <div class="wrap">
      <div class="fo-grid">
        <div class="fo-pitch">
          매주 만들고,<br /><em>각자</em> 나눈다.
        </div>
        <div class="fo-col">
          <h4>둘러보기</h4>
          <ul>
            <li><a href="#about">소개</a></li>
            <li><a href="#this-issue">이번 호</a></li>
            <li><a href="/keywords/">키워드 분석</a></li>
            <li><a href="/skills/">스킬 사이트 모음</a></li>
            <li><a href="/gallery/">산출물 갤러리</a></li>
          </ul>
        </div>
        <div class="fo-col">
          <h4>연결</h4>
          <ul>
            <li><a href="https://github.com/spongeclub/spongeclub_1">GitHub</a></li>
            <li><a href="#about">참여 안내</a></li>
          </ul>
        </div>
      </div>
      <div class="fo-bot">
        <span>© {year} SPONGECLUB — Built every week.</span>
        <span>SEOUL / REPUBLIC OF KOREA</span>
      </div>
    </div>
  </footer>
</Layout>

<style is:global>
/* ─── HERO: 이번 주 MVP ─────────────────────────── */
.hero-mvp .hero-title { margin-bottom: 12px; }
.hero-mvp .hero-lede { margin-bottom: 36px; }

.mvp-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border: 4px solid var(--fg);
  background: var(--white);
}
.mvp-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 24px 22px;
  border-right: 4px solid var(--fg);
  border-bottom: 4px solid var(--fg);
  text-decoration: none;
  color: var(--fg);
  background: var(--white);
  transition: background 0.15s;
}
.mvp-card:nth-child(3n) { border-right: none; }
.mvp-card:nth-last-child(-n+3) { border-bottom: none; }
.mvp-card:hover { background: var(--key); }
.mvp-team {
  display: inline-block;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
  padding: 4px 8px;
  background: var(--fg);
  color: var(--white);
  align-self: flex-start;
}
.mvp-name { font-size: 22px; font-weight: 900; line-height: 1.2; }
.mvp-title { font-size: 14px; font-weight: 700; line-height: 1.4; color: var(--fg); }
.mvp-excerpt { font-size: 13px; line-height: 1.55; color: #555; }
.mvp-reason { font-size: 12px; line-height: 1.55; color: #555; border-left: 3px solid var(--key); padding-left: 8px; margin-top: 4px; }

@media (max-width: 900px) {
  .mvp-grid { grid-template-columns: repeat(2, 1fr); }
  .mvp-card:nth-child(3n) { border-right: 4px solid var(--fg); }
  .mvp-card:nth-child(2n) { border-right: none; }
  .mvp-card:nth-last-child(-n+3) { border-bottom: 4px solid var(--fg); }
  .mvp-card:nth-last-child(-n+2) { border-bottom: none; }
}
@media (max-width: 560px) {
  .mvp-grid { grid-template-columns: 1fr; }
  .mvp-card { border-right: none !important; border-bottom: 4px solid var(--fg) !important; }
  .mvp-card:last-child { border-bottom: none !important; }
}

/* ─── 신규 스킬 TOP 3 ────────────────────────────── */
.skills-top3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border: 4px solid var(--fg);
  background: var(--white);
}
.skill-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 22px;
  border-right: 4px solid var(--fg);
  text-decoration: none;
  color: var(--fg);
  background: var(--white);
  transition: background 0.15s;
}
.skill-card:last-child { border-right: none; }
.skill-card:hover { background: var(--key); }
.skill-meta { display: flex; justify-content: space-between; align-items: center; font-size: 11px; }
.sk-cat { font-weight: 900; letter-spacing: 0.08em; }
.sk-date { color: #777; font-variant-numeric: tabular-nums; }
.skill-name { font-size: 22px; font-weight: 900; line-height: 1.2; }
.skill-summary { font-size: 14px; line-height: 1.5; color: #333; }
.skill-foot { font-size: 12px; color: #555; margin-top: auto; padding-top: 8px; }

@media (max-width: 900px) {
  .skills-top3 { grid-template-columns: 1fr; }
  .skill-card { border-right: none; border-bottom: 4px solid var(--fg); }
  .skill-card:last-child { border-bottom: none; }
}

.skills-more, .issue-cta-row {
  margin-top: 18px;
  text-align: right;
}
.more-cta {
  display: inline-block;
  font-weight: 900;
  text-decoration: none;
  color: var(--fg);
  border-bottom: 3px solid var(--fg);
  padding-bottom: 2px;
}
.more-cta:hover { color: var(--red); border-color: var(--red); }

/* ─── 6조 카드 그리드 ────────────────────────────── */
.team-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  border: 4px solid var(--fg);
  background: var(--white);
}
.team-card {
  display: flex;
  flex-direction: column;
  border-right: 4px solid var(--fg);
  border-bottom: 4px solid var(--fg);
  background: var(--white);
}
.team-card:nth-child(3n) { border-right: none; }
.team-card:nth-last-child(-n+3) { border-bottom: none; }
.tc-head {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 16px 20px;
  background: var(--fg);
  color: var(--white);
}
.tc-team { font-size: 12px; font-weight: 900; letter-spacing: 0.1em; opacity: 0.7; }
.tc-theme { font-size: 17px; font-weight: 900; line-height: 1.3; }
.tc-body { padding: 18px 20px; display: flex; flex-direction: column; gap: 14px; }
.tc-section { display: flex; flex-direction: column; gap: 4px; }
.tc-label { font-size: 11px; font-weight: 900; letter-spacing: 0.08em; color: #777; }
.tc-text { font-size: 13px; line-height: 1.55; color: var(--fg); margin: 0; }
.tc-insight .tc-label { color: var(--red); }
.tc-insight .tc-text { background: var(--key); padding: 8px 10px; }

@media (max-width: 900px) {
  .team-grid { grid-template-columns: repeat(2, 1fr); }
  .team-card:nth-child(3n) { border-right: 4px solid var(--fg); }
  .team-card:nth-child(2n) { border-right: none; }
  .team-card:nth-last-child(-n+3) { border-bottom: 4px solid var(--fg); }
  .team-card:nth-last-child(-n+2) { border-bottom: none; }
}
@media (max-width: 560px) {
  .team-grid { grid-template-columns: 1fr; }
  .team-card { border-right: none !important; border-bottom: 4px solid var(--fg) !important; }
  .team-card:last-child { border-bottom: none !important; }
}
</style>
