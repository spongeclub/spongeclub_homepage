---
import Layout from '../layouts/Layout.astro';
import SpongeVillageGif from '../components/SpongeVillageGif.astro';
import {
  buildAllWeeks,
  buildWeekArticles,
  buildArticle,
  pickFeature,
  cardTitle,
  weekTheme,
  loadTeamAnalyses,
} from '../lib/data';
import { loadCuratedSkills, getLatestSkills } from '../lib/curated-skills';

// 발행된 호 = 제출 기록이 1건 이상 있는 주차만
const weeks = buildAllWeeks().filter((w) => w.submittedCount > 0);
const hasData = weeks.length > 0;
const latest = hasData ? weeks[weeks.length - 1] : null;

const totalWeeks = weeks.length;
const totalMembers = latest ? latest.totalMembers : 0;
const totalSubmissions = weeks.reduce((sum, w) => sum + w.submittedCount, 0);

const latestArticles = latest ? buildWeekArticles(latest) : [];
pickFeature(latestArticles); // 호환 유지 (사용처 없음)

const pastIssues = [...weeks].reverse().map((w) => {
  const arts = buildWeekArticles(w);
  return { week: w, theme: weekTheme(arts), count: arts.length };
});

// 신규 등록 스킬 TOP 3 (skill md `created` 기준 최신)
const latestSkills = getLatestSkills(loadCuratedSkills(), 3);

// 이번 주 MVP — submit.md frontmatter `mvp: true` 기준
const teamOrder = ['1조', '2조', '3조', '4조', '5조', '6조'];
const mvpSubmissions = latest
  ? latest.submissions.filter((s) => s.mvp && s.filePath)
  : [];
const weeklyMvps = teamOrder.map((team) => {
  const sub = mvpSubmissions.find((s) => s.member.team === team);
  if (!sub || !latest) return { team, nickname: '미정', title: '이번 주 미정', excerpt: '', reason: '', url: '#' };
  const art = buildArticle(sub, latest.weekNumber);
  return {
    team,
    nickname: sub.member.nickname,
    title: art ? cardTitle(art) : (sub.noteTitle || ''),
    excerpt: art ? (art.excerpt || '').slice(0, 90) : '',
    reason: sub.mvpReason || '',
    url: art?.url || '#',
  };
});

// 조별 마을 hotspot — 6조 각자의 이번 호 페이지로 이동
const villageTeams = teamOrder.map((team) => ({
  name: team,
  href: latest ? `/issue/${latest.weekNumber}/` : '#',
}));

// 조별 분석 카드 — 90_analysis/teams/Week_0N_조M.md 에서 로드
const teamAnalyses = latest ? loadTeamAnalyses(latest.weekNumber) : [];
const teamCards = teamOrder.map((team) => {
  const a = teamAnalyses.find((x) => x.team === team);
  if (a) return { team, theme: a.theme, summary: a.summary, insight: a.insight };
  return {
    team,
    theme: `${latest?.weekNumber ?? ''}주차의 기록`,
    summary: '아직 분석이 생성되지 않았습니다.',
    insight: '',
  };
});

const weekLabel = (n: number) => `WEEK ${String(n).padStart(2, '0')}`;
const year = new Date().getFullYear();
---

<Layout title="스폰지클럽 — 매주 만들고, 각자 나눈다" bodyClass="hp-body">
  <!-- ─── HEADER ─────────────────────────────────────── -->
  <header class="hp-header">
    <div class="hp-header-inner">
      <a href="/" class="hp-brand">
        <span class="hp-brand-mark">🧽</span>
        <span class="hp-brand-name">spongeclub</span>
      </a>
      <nav class="hp-nav" aria-label="메인 메뉴">
        <a href="#this-issue">이번 호</a>
        <a href="/keywords/">키워드</a>
        <a href="/skills/">스킬</a>
        <a href="/gallery/">갤러리</a>
        <a href="#archive">지난 호</a>
      </nav>
      {latest && (
        <span class="hp-week-pill">{weekLabel(latest.weekNumber)}</span>
      )}
    </div>
  </header>

  {!hasData && (
    <main class="hp-empty">
      <h1>스폰지클럽</h1>
      <p>아직 발행된 호가 없습니다.</p>
    </main>
  )}

  {hasData && (
    <>
      <!-- ─── HERO (잡지 표지: 텍스트 + 비키니바텀 마을) ───── -->
      <section class="hp-hero">
        <div class="hp-hero-text">
          {latest && <span class="hp-hero-kicker">{weekLabel(latest.weekNumber)} · {year}</span>}
          <h1 class="hp-hero-title">
            매주 만들고,<br />
            <span class="hp-highlight">각자</span> 나눈다.
          </h1>
          <p class="hp-hero-lede">
            {totalMembers}명이 매주 무언가를 만들고, 그 과정을 기록하는 AI 빌더 커뮤니티.<br />
            아래는 이번 호 <b>{latest && weekLabel(latest.weekNumber)}</b> 6개 조의 진척도.
          </p>
          <div class="hp-hero-cta">
            <a class="hp-btn hp-btn-dark" href="#this-issue">이번 호 보기 →</a>
            <a class="hp-btn hp-btn-ghost" href="#archive">지난 호</a>
          </div>
        </div>

        <div class="hp-hero-village">
          <SpongeVillageGif teams={villageTeams} />
        </div>
      </section>

      <!-- ─── STATS 옐로우 시그니처 띠 ────────────── -->
      <section class="hp-stats">
        <div class="hp-stats-inner">
          <div class="hp-stat">
            <span class="hp-stat-num">{String(totalWeeks).padStart(2, '0')}</span>
            <span class="hp-stat-label">발행 호</span>
          </div>
          <div class="hp-stat">
            <span class="hp-stat-num">{totalMembers}</span>
            <span class="hp-stat-label">멤버</span>
          </div>
          <div class="hp-stat">
            <span class="hp-stat-num">{totalSubmissions}</span>
            <span class="hp-stat-label">누적 기록</span>
          </div>
          <div class="hp-stat">
            <span class="hp-stat-num">06</span>
            <span class="hp-stat-label">조</span>
          </div>
        </div>
      </section>

      <main class="hp-main">

        <!-- ─── ● MVP ──────────────────────────────── -->
        <section class="hp-section" id="mvp">
          <div class="hp-sh">
            <span class="sc-shape sc-shape--circle" aria-hidden="true"></span>
            <h2 class="hp-sh-title">이번 호 MVP</h2>
            <p class="hp-sh-desc">6개 조에서 한 명씩 — 이번 호의 6인</p>
          </div>
          <div class="hp-mvp-grid">
            {weeklyMvps.map((m) => (
              <a class="hp-mvp-card" href={m.url}>
                <span class="hp-mvp-team">{m.team}</span>
                <span class="hp-mvp-name">{m.nickname}</span>
                <p class="hp-mvp-title">{m.title}</p>
                {m.reason && <p class="hp-mvp-reason">★ {m.reason}</p>}
              </a>
            ))}
          </div>
        </section>

        <!-- ─── ■ 이번 호 (조별 기록) ─────────────── -->
        {latest && (
          <section class="hp-section" id="this-issue">
            <div class="hp-sh">
              <span class="sc-shape sc-shape--square" aria-hidden="true"></span>
              <h2 class="hp-sh-title">{latest.weekNumber}주차의 기록</h2>
              <p class="hp-sh-desc">
                {latestArticles.length}명이 이번 주 만든 것 — 전체는 이슈 페이지에서.
              </p>
            </div>
            <div class="hp-team-grid">
              {teamCards.map((t) => (
                <article class="hp-team-card">
                  <header class="hp-team-card-head">
                    <span class="hp-team-card-team">{t.team}</span>
                    <h3 class="hp-team-card-theme">{t.theme}</h3>
                  </header>
                  <div class="hp-team-card-body">
                    <div class="hp-team-card-block">
                      <span class="hp-team-card-label">요약</span>
                      <p class="hp-team-card-text">{t.summary}</p>
                    </div>
                    {t.insight && (
                      <div class="hp-team-card-block hp-team-card-block--insight">
                        <span class="hp-team-card-label">★ 클로드 인사이트</span>
                        <p class="hp-team-card-text">{t.insight}</p>
                      </div>
                    )}
                  </div>
                </article>
              ))}
            </div>
            <div class="hp-more">
              <a class="hp-more-link" href={`/issue/${latest.weekNumber}/`}>
                이번 호 전체 기록 보기 →
              </a>
            </div>
          </section>
        )}

        <!-- ─── ▲ 신규 스킬 ───────────────────────── -->
        {latestSkills.length > 0 && (
          <section class="hp-section" id="new-skills">
            <div class="hp-sh">
              <span class="sc-shape sc-shape--triangle" aria-hidden="true"></span>
              <h2 class="hp-sh-title">방금 등록된 스킬</h2>
              <p class="hp-sh-desc">이번 주 새로 들어온 스킬 후기 — 따끈할 때 보세요.</p>
            </div>
            <div class="hp-skills-grid">
              {latestSkills.map((sk) => (
                <a class="hp-skill-card" href={`/skills/#${sk.slug}`}>
                  <div class="hp-skill-meta">
                    <span class="hp-skill-cat">{sk.category}</span>
                    {sk.created && <span class="hp-skill-date">{sk.created}</span>}
                  </div>
                  <h3 class="hp-skill-name">{sk.summary || sk.skillName || sk.title}</h3>
                  <p class="hp-skill-handle">{sk.skillName}</p>
                  {sk.userCount > 0 && (
                    <span class="hp-skill-fire">🔥 {sk.userCount}명이 써봄</span>
                  )}
                </a>
              ))}
            </div>
            <div class="hp-more">
              <a class="hp-more-link" href="/skills/">스킬 전체 보기 →</a>
            </div>
          </section>
        )}

        <!-- ─── ■ 지난 호 ──────────────────────────── -->
        <section class="hp-section" id="archive">
          <div class="hp-sh">
            <span class="sc-shape sc-shape--square" aria-hidden="true"></span>
            <h2 class="hp-sh-title">지난 호</h2>
            <p class="hp-sh-desc">매주 한 호씩 — 열면 그 주의 모든 기록이 조별로 펼쳐집니다.</p>
          </div>
          <div class="hp-issue-grid">
            {pastIssues.map(({ week, theme, count }) => (
              <a class="hp-issue-card" href={`/issue/${week.weekNumber}/`}>
                <span class="hp-issue-vol">{weekLabel(week.weekNumber)}</span>
                <h3 class="hp-issue-title">
                  {theme || `${week.weekNumber}주차의 기록`}
                </h3>
                <span class="hp-issue-meta">
                  {count}개 기록{week.dateLabel ? ` · ${week.dateLabel}` : ''}
                </span>
              </a>
            ))}
          </div>
        </section>

        <!-- ─── DARK CTA (한 페이지 1개) ──────────── -->
        <section class="hp-cta">
          <p class="hp-cta-head">매주 한 호씩,<br />스폰지클럽.</p>
          <p class="hp-cta-body">
            새 호가 발행되면 가장 먼저 알려드립니다.
          </p>
          <a class="hp-cta-btn"
             href="https://spongeclub-community.vercel.app/"
             target="_blank" rel="noopener noreferrer">
            커뮤니티 열기 →
          </a>
        </section>
      </main>
    </>
  )}

  <!-- ─── FOOTER ─────────────────────────────────── -->
  <footer class="hp-footer">
    <div class="hp-footer-inner">
      <div class="hp-footer-brand">
        <span class="hp-brand-name">spongeclub</span>
        <p class="hp-footer-pitch">매주 만들고, <span class="hp-highlight">각자</span> 나눈다.</p>
      </div>
      <div class="hp-footer-cols">
        <div class="hp-footer-col">
          <h4>둘러보기</h4>
          <ul>
            <li><a href="#this-issue">이번 호</a></li>
            <li><a href="/keywords/">키워드</a></li>
            <li><a href="/skills/">스킬</a></li>
            <li><a href="/gallery/">갤러리</a></li>
          </ul>
        </div>
        <div class="hp-footer-col">
          <h4>연결</h4>
          <ul>
            <li><a href="https://github.com/spongeclub/spongeclub_1" target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href="https://spongeclub-community.vercel.app/" target="_blank" rel="noopener noreferrer">커뮤니티</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="hp-footer-bot">
      © {year} SPONGECLUB · Seoul · Republic of Korea
    </div>
  </footer>
</Layout>

<style is:global>
  /* ═══════════════════════════════════════════════════════
     /index — 스폰지클럽 디자인 시스템 적용 (hp-* prefix)
     ═══════════════════════════════════════════════════════ */

  body.hp-body {
    margin: 0;
    min-height: 100vh;
    background: var(--sc-bg-base);
    color: var(--sc-text-primary);
    font-family: var(--sc-font-body);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  body.hp-body * { box-sizing: border-box; }
  body.hp-body h1, body.hp-body h2, body.hp-body h3, body.hp-body h4, body.hp-body p, body.hp-body ul { margin: 0; padding: 0; }
  body.hp-body ul { list-style: none; }
  body.hp-body a { color: inherit; text-decoration: none; }
  body.hp-body button { font: inherit; color: inherit; background: none; border: none; cursor: pointer; }

  /* ─── 공통 ─── */
  .hp-highlight {
    background: linear-gradient(transparent 55%, var(--sc-highlight-orange) 55%);
    font-weight: 700;
    padding: 0 4px;
  }

  /* ─── HEADER ─── */
  .hp-header {
    position: sticky; top: 0; z-index: 30;
    background: var(--sc-bg-base);
    border-bottom: 1px solid var(--sc-border-soft);
  }
  .hp-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex; align-items: center; gap: 24px;
  }
  .hp-brand {
    display: inline-flex; align-items: baseline; gap: 8px;
    flex-shrink: 0;
  }
  .hp-brand-mark { font-size: 22px; line-height: 1; }
  .hp-brand-name {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 24px;
    letter-spacing: -0.01em;
    color: var(--sc-text-primary);
  }
  .hp-nav {
    display: flex; align-items: center; gap: 22px;
    margin-left: auto;
    font-size: 14px;
    font-weight: 500;
  }
  .hp-nav a {
    color: var(--sc-text-muted-mid);
    transition: color 160ms;
  }
  .hp-nav a:hover { color: var(--sc-text-primary); }
  .hp-week-pill {
    flex-shrink: 0;
    font-family: var(--sc-font-body);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.06em;
    padding: 7px 14px;
    border-radius: var(--sc-radius-pill);
    background: var(--sc-bg-signature);
    color: var(--sc-text-primary);
  }
  @media (max-width: 860px) {
    .hp-nav { gap: 14px; font-size: 13px; }
    .hp-nav a:nth-child(4),
    .hp-nav a:nth-child(5) { display: none; }
  }
  @media (max-width: 540px) {
    .hp-nav a:nth-child(2),
    .hp-nav a:nth-child(3) { display: none; }
  }

  /* ─── HERO (잡지 표지) — GIF 배경 + 텍스트 오버레이 ─── */
  .hp-hero {
    position: relative;
    isolation: isolate;
    width: 100%;
  }
  .hp-hero-village {
    width: 100%;
    display: block;
  }
  .hp-hero-village .sv-village {
    aspect-ratio: 1440 / 460;
    max-height: 64vh;
  }
  /* 텍스트는 GIF 위 좌상단 카드처럼 */
  .hp-hero-text {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    max-width: 1200px;
    margin-inline: auto;
    padding: clamp(20px, 3.4vw, 44px);
    display: flex; flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .hp-hero-text > * { pointer-events: auto; }
  .hp-hero-kicker {
    font-family: var(--sc-font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--sc-text-primary);
    background: var(--sc-bg-signature);
    padding: 6px 13px;
    border-radius: var(--sc-radius-pill);
    box-shadow: 0 4px 14px rgba(26, 31, 54, 0.12);
  }
  .hp-hero-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(30px, 4.4vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--sc-text-primary);
    max-width: 600px;
    background: var(--sc-bg-signature);
    padding: 6px 14px;
    border-radius: 12px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    box-shadow: 0 6px 18px rgba(26, 31, 54, 0.10);
  }
  .hp-hero-lede {
    font-size: clamp(12px, 1.2vw, 14.5px);
    font-weight: 500;
    line-height: 1.55;
    color: var(--sc-text-primary);
    max-width: 460px;
    background: rgba(255, 251, 237, 0.92);
    padding: 8px 12px;
    border-radius: 10px;
    backdrop-filter: blur(2px);
    box-shadow: 0 4px 14px rgba(26, 31, 54, 0.08);
  }
  .hp-hero-cta {
    margin-top: 6px;
    display: flex; gap: 10px; flex-wrap: wrap;
  }
  .hp-btn {
    padding: 13px 24px;
    border-radius: var(--sc-radius-pill);
    font-weight: 700;
    font-size: 14px;
    transition: filter 160ms, transform 160ms, background 160ms;
  }
  .hp-btn-dark {
    background: var(--sc-surface-dark);
    color: var(--sc-text-on-dark);
  }
  .hp-btn-dark:hover { transform: translateY(-1px); filter: brightness(1.06); }
  .hp-btn-ghost {
    background: transparent;
    color: var(--sc-text-primary);
    border: 1.5px solid var(--sc-text-primary);
  }
  .hp-btn-ghost:hover { background: var(--sc-text-primary); color: var(--sc-bg-signature); }

  /* ─── STATS 옐로우 띠 (시그니처 옐로우 사용처 1) ─── */
  .hp-stats {
    background: var(--sc-bg-signature);
    border-top: 1px solid rgba(26, 31, 54, 0.10);
    border-bottom: 1px solid rgba(26, 31, 54, 0.10);
  }
  .hp-stats-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .hp-stat {
    display: flex; flex-direction: column; align-items: center;
    gap: 4px;
    text-align: center;
  }
  .hp-stat-num {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1;
    color: var(--sc-text-primary);
    font-variant-numeric: tabular-nums;
  }
  .hp-stat-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(26, 31, 54, 0.65);
  }
  @media (max-width: 600px) {
    .hp-stats-inner { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }

  /* ─── MAIN ─── */
  .hp-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 24px 80px;
    display: flex; flex-direction: column; gap: 64px;
  }

  /* ─── SECTION HEADING ─── */
  .hp-section { display: flex; flex-direction: column; gap: 24px; }
  .hp-sh {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 18px;
    row-gap: 4px;
    align-items: end;
  }
  .hp-sh .sc-shape {
    grid-row: 1 / span 2;
    align-self: end;
    margin-bottom: 8px;
  }
  .hp-sh-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--sc-text-primary);
  }
  .hp-sh-desc {
    font-size: 14px;
    font-weight: 500;
    color: var(--sc-text-muted-mid);
    margin-top: -2px;
  }

  /* ─── MVP 그리드 ─── */
  .hp-mvp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .hp-mvp-card {
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    padding: 22px 22px 20px;
    display: flex; flex-direction: column; gap: 8px;
    transition: transform 160ms, box-shadow 160ms, border-color 160ms;
  }
  .hp-mvp-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(26, 31, 54, 0.07);
    border-color: var(--sc-accent-blue);
  }
  .hp-mvp-team {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
