---
import Layout from '../layouts/Layout.astro';
import {
  buildAllWeeks,
  buildWeekArticles,
  pickFeature,
  cardTitle,
  weekTheme,
} from '../lib/data';

// 발행된 호 = 제출 기록이 1건 이상 있는 주차만
const weeks = buildAllWeeks().filter((w) => w.submittedCount > 0);
const hasData = weeks.length > 0;
const latest = hasData ? weeks[weeks.length - 1] : null;

const totalWeeks = weeks.length;
const totalMembers = latest ? latest.totalMembers : 0;
const totalSubmissions = weeks.reduce((sum, w) => sum + w.submittedCount, 0);

const latestArticles = latest ? buildWeekArticles(latest) : [];
const feature = pickFeature(latestArticles);
const sideArticles = latestArticles.filter((a) => a !== feature).slice(0, 4);

const pastIssues = [...weeks].reverse().map((w) => {
  const arts = buildWeekArticles(w);
  return { week: w, theme: weekTheme(arts), count: arts.length };
});

const vol = (n: number) => `VOL.${String(n).padStart(2, '0')}`;
const year = new Date().getFullYear();
---

<Layout title="스폰지클럽 — 매주 만들고, 각자 나눈다" bodyClass="mag">
  <!-- ═══ NAV ═══ -->
  <nav class="nav">
    <div class="wrap nav-inner">
      <a href="/" class="brand">
        <span class="brand-shapes" aria-hidden="true">
          <span class="s-c"></span>
          <span class="s-s"></span>
          <span class="s-t"></span>
        </span>
        <span>스폰지클럽</span>
      </a>
      <div class="nav-links">
        <a href="#about">소개</a>
        <a href="#this-issue">이번 호</a>
        <a href="/keywords/">키워드</a>
        <a href="/skills/">스킬모음</a>
        <a href="/gallery/">갤러리</a>
        <a href="/board/">현황판</a>
      </div>
      {latest && <span class="nav-vol">{vol(latest.weekNumber)}</span>}
    </div>
  </nav>

  <main class="wrap">
    {!hasData && (
      <section class="hero">
        <h1 class="hero-title">스폰지클럽</h1>
        <p class="hero-lede">아직 발행된 호가 없습니다.</p>
      </section>
    )}

    {hasData && (
      <>
        <!-- ═══ HERO / 소개 ═══ -->
        <section class="hero" id="about">
          <div class="hero-deco" aria-hidden="true">
            <span class="d-c"></span>
            <span class="d-s"></span>
          </div>
          <div class="hero-kicker reveal d1">
            <span>스폰지클럽 — <b>매주 만들고, 각자 나눈다</b></span>
            <span>{latest && vol(latest.weekNumber)} · {year}</span>
          </div>
          <h1 class="hero-title reveal d2">
            매주 만들고,<br />
            <em>각자</em> 나눈다.
          </h1>
          <p class="hero-lede reveal d3">
            {totalMembers}명이 매주 무언가를 만들고, 그 과정을 기록하는 AI 빌더 커뮤니티.<br />
            이 페이지는 매주 한 호씩 발행되는 그 기록입니다.
          </p>
          <div class="hero-stats reveal d4">
            <div>
              <div class="n">{String(totalWeeks).padStart(2, '0')}</div>
              <div class="l">발행 호 / Issues</div>
            </div>
            <div>
              <div class="n">{totalMembers}</div>
              <div class="l">멤버 / Members</div>
            </div>
            <div>
              <div class="n">{totalSubmissions}</div>
              <div class="l">누적 기록 / Records</div>
            </div>
            <div>
              <div class="n">06</div>
              <div class="l">조 / Teams</div>
            </div>
          </div>
        </section>

        <!-- ═══ 운영 방식 3스텝 ═══ -->
        <section class="s">
          <div class="s-head">
            <div>
              <div class="s-num">어떻게 굴러가나</div>
              <h2 class="s-title">매주 같은 <em>리듬</em></h2>
            </div>
            <p class="s-desc">
              스폰지클럽은 한 주를 세 동작으로 돈다. 6주째 이 리듬이 멈춘 적 없다.
            </p>
          </div>
          <div class="howto">
            <div class="howto-step">
              <span class="step-n">STEP 01</span>
              <span class="step-t">만든다</span>
              <p class="step-d">
                각자 한 주의 미션을 정하고, 손에 잡히는 결과물을 만든다.
                도구·프로덕트·콘텐츠 — 형태는 자유다.
              </p>
            </div>
            <div class="howto-step">
              <span class="step-n">STEP 02</span>
              <span class="step-t">나눈다</span>
              <p class="step-d">
                조별 공유회에서 보여주고, 서로 피드백을 주고받는다.
                혼자 가던 길이 같이 가는 길이 된다.
              </p>
            </div>
            <div class="howto-step">
              <span class="step-n">STEP 03</span>
              <span class="step-t">남긴다</span>
              <p class="step-d">
                만든 과정과 인사이트를 노트로 기록한다.
                그 기록이 모여 이 매거진의 한 호가 된다.
              </p>
            </div>
          </div>
        </section>

        <!-- ═══ 이번 호 ═══ -->
        {latest && (
          <section class="s" id="this-issue">
            <div class="s-head">
              <div>
                <div class="s-num">{vol(latest.weekNumber)} — 이번 호</div>
                <h2 class="s-title">{latest.weekNumber}주차의 <em>기록</em></h2>
              </div>
              <p class="s-desc">
                {latestArticles.length}명이 이번 주 만든 것을 기록했다.
                전체는 이슈 페이지에서.
              </p>
            </div>

            {feature ? (
              <div class="cover">
                <div class="cover-main">
                  <span class="cover-tag">★ 이번 호 주요 기사</span>
                  <h3 class="cover-headline">{cardTitle(feature)}</h3>
                  <p class="cover-excerpt">{feature.excerpt}</p>
                  <div class="cover-by">
                    글 ·{' '}
                    <a
                      href={`/member/${encodeURIComponent(feature.member.team)}/${encodeURIComponent(feature.member.nickname)}/`}
                    >
                      <b>{feature.member.nickname}</b>
                    </a>{' '}
                    · {feature.member.team}
                  </div>
                  <a class="cover-cta" href={`/issue/${latest.weekNumber}/`}>
                    이번 호 전체 보기 →
                  </a>
                </div>
                <div class="cover-side">
                  {sideArticles.map((a) => (
                    <a class="cover-side-row" href={a.url}>
                      <span class="r-team">{a.member.team}</span>
                      <span class="r-title">{cardTitle(a)}</span>
                      <span class="r-by">{a.member.nickname}</span>
                    </a>
                  ))}
                  {sideArticles.length === 0 && (
                    <div class="cover-side-row">
                      <span class="r-by">다른 기록이 곧 채워집니다.</span>
                    </div>
                  )}
                </div>
              </div>
            ) : (
              <div class="empty-note">이번 호에 아직 제출된 기록이 없습니다.</div>
            )}
          </section>
        )}

        <!-- ═══ 지난 호 ═══ -->
        <section class="s" id="archive">
          <div class="s-head">
            <div>
              <div class="s-num">아카이브</div>
              <h2 class="s-title">지난 <em>호</em></h2>
            </div>
            <p class="s-desc">
              매주 한 호씩. 한 호를 열면 그 주의 모든 기록이 조별로 펼쳐진다.
            </p>
          </div>
          <div class="issue-grid">
            {pastIssues.map(({ week, theme, count }) => (
              <a class="issue-card" href={`/issue/${week.weekNumber}/`}>
                <span class="ic-vol">{vol(week.weekNumber)}</span>
                <span class="ic-title">
                  {theme || `${week.weekNumber}주차의 기록`}
                </span>
                <span class="ic-meta">
                  {count}개 기록{week.dateLabel ? ` · ${week.dateLabel}` : ''}
                </span>
              </a>
            ))}
          </div>
        </section>
      </>
    )}
  </main>

  <!-- ═══ FOOTER ═══ -->
  <footer class="mag-footer">
    <div class="wrap">
      <div class="fo-grid">
        <div class="fo-pitch">
          매주 만들고,<br /><em>각자</em> 나눈다.
        </div>
        <div class="fo-col">
          <h4>둘러보기</h4>
          <ul>
            <li><a href="#about">소개</a></li>
            <li><a href="#this-issue">이번 호</a></li>
            <li><a href="/keywords/">키워드 분석</a></li>
            <li><a href="/skills/">스킬 사이트 모음</a></li>
            <li><a href="/gallery/">산출물 갤러리</a></li>
            <li><a href="/board/">과제 현황판</a></li>
          </ul>
        </div>
        <div class="fo-col">
          <h4>연결</h4>
          <ul>
            <li><a href="https://github.com/spongeclub/spongeclub_1">GitHub</a></li>
            <li><a href="#about">참여 안내</a></li>
          </ul>
        </div>
      </div>
      <div class="fo-bot">
        <span>© {year} SPONGECLUB — Built every week.</span>
        <span>SEOUL / REPUBLIC OF KOREA</span>
      </div>
    </div>
  </footer>
</Layout>
