---
import Layout from '../layouts/Layout.astro';
import { buildOverallTopics, buildWeekKeywords } from '../lib/analysis';

const overallTopics = buildOverallTopics().slice(0, 30);
const weekKeywords  = buildWeekKeywords();

// Summary stats
const totalKeywords  = overallTopics.length;
const totalWeeks     = weekKeywords.length;
const topKeyword     = overallTopics[0]?.keyword ?? '—';
const topKeywordCount = overallTopics[0]?.count ?? 0;

// Compute font-size scale for keyword cloud (min 13px → max 36px)
const maxCount = overallTopics[0]?.count ?? 1;
const minCount = overallTopics[overallTopics.length - 1]?.count ?? 1;
function cloudSize(count: number): number {
  if (maxCount === minCount) return 22;
  const ratio = (count - minCount) / (maxCount - minCount);
  return Math.round(13 + ratio * 23);
}
function cloudWeight(count: number): number {
  if (maxCount === minCount) return 700;
  const ratio = (count - minCount) / (maxCount - minCount);
  return ratio > 0.6 ? 900 : ratio > 0.3 ? 700 : 500;
}
// Tier: top 20% = key-yellow chip; top 50% = fg border only; rest = muted
function cloudTier(count: number): 'top' | 'mid' | 'low' {
  if (maxCount === minCount) return 'mid';
  const ratio = (count - minCount) / (maxCount - minCount);
  if (ratio >= 0.8) return 'top';
  if (ratio >= 0.4) return 'mid';
  return 'low';
}
---

<Layout title="키워드 분석 — 스폰지클럽" bodyClass="mag">
  <!-- ═══ NAV ═══ -->
  <nav class="nav">
    <div class="wrap nav-inner">
      <a href="/" class="brand">
        <span class="brand-shapes" aria-hidden="true">
          <span class="s-c"></span><span class="s-s"></span><span class="s-t"></span>
        </span>
        <span>스폰지클럽</span>
      </a>
      <div class="nav-links">
        <a href="/board/">현황판</a>
        <a href="/keywords/" aria-current="page">키워드</a>
        <a href="/skills/">스킬모음</a>
        <a href="/gallery/">갤러리</a>
      </div>
    </div>
  </nav>

  <main class="wrap">
    <!-- ═══ 요약 헤더 ═══ -->
    <div class="kw-summary reveal d1">
      <div class="kws-label">키워드 분석</div>
      <p class="kws-body">
        멤버들이 <strong>{totalWeeks}주</strong>에 걸쳐 공유한 키워드를 집계했습니다.
        총 <strong>{totalKeywords}개</strong>의 고유 토픽 중 가장 많이 언급된 주제는
        <strong class="kws-top">"{topKeyword}"</strong>({topKeywordCount}명)입니다.
      </p>
      <div class="kws-stats">
        <div class="kws-stat">
          <span class="kws-n">{totalKeywords}</span>
          <span class="kws-l">고유 키워드</span>
        </div>
        <div class="kws-stat">
          <span class="kws-n">{totalWeeks}</span>
          <span class="kws-l">집계 주차</span>
        </div>
        <div class="kws-stat kws-stat--key">
          <span class="kws-n">{topKeyword}</span>
          <span class="kws-l">최다 토픽</span>
        </div>
        <div class="kws-stat">
          <span class="kws-n">{topKeywordCount}</span>
          <span class="kws-l">최다 언급수</span>
        </div>
      </div>
    </div>

    <!-- ═══ 페이지 헤더 ═══ -->
    <section class="s" style="padding-top: clamp(56px, 10vh, 100px);">
      <div class="s-head">
        <div>
          <div class="s-num">키워드 분석</div>
          <h1 class="s-title">무엇을 <em>만들고</em> 나눴나</h1>
        </div>
        <p class="s-desc">
          멤버들이 공유한 키워드를 집계했습니다.
          종합 <strong>{overallTopics.length}개</strong> 주요 토픽,
          주차별 흐름을 확인하세요.
        </p>
      </div>
    </section>

    <!-- ═══ 종합 키워드 클라우드 ═══ -->
    <section class="s" id="overall">
      <div class="s-head">
        <div>
          <div class="s-num">01 — 종합</div>
          <h2 class="s-title">전체 <em>키워드</em></h2>
        </div>
        <p class="s-desc">
          전 기간 멤버 키워드를 집계한 Top {overallTopics.length}.
          글자 크기는 다룬 멤버 수를 반영합니다.
        </p>
      </div>

      {overallTopics.length === 0 ? (
        <div class="empty-note">아직 집계된 키워드가 없습니다.</div>
      ) : (
        <div class="kw-cloud">
          {overallTopics.map((topic) => (
            <details class="kw-item" data-tier={cloudTier(topic.count)}>
              <summary
                class="kw-word"
                style={`font-size:${cloudSize(topic.count)}px; font-weight:${cloudWeight(topic.count)};`}
              >
                {topic.keyword}
                <span class="kw-cnt">{topic.count}</span>
              </summary>
              <div class="kw-members">
                {topic.members.map((m) => (
                  <a
                    href={`/member/${encodeURIComponent(m.team)}/${encodeURIComponent(m.nickname)}/`}
                    class="member-chip"
                  >
                    <span class="mc-team">{m.team}</span>
                    <span class="mc-name">{m.nickname}</span>
                  </a>
                ))}
              </div>
            </details>
          ))}
        </div>
      )}
    </section>

    <!-- ═══ 주차별 키워드 ═══ -->
    <section class="s" id="by-week">
      <div class="s-head">
        <div>
          <div class="s-num">02 — 주차별</div>
          <h2 class="s-title">주차별 <em>흐름</em></h2>
        </div>
        <p class="s-desc">
          각 주차에 어떤 키워드가 오갔는지 확인하세요.
          키워드를 누르면 다룬 멤버 목록이 펼쳐집니다.
        </p>
      </div>

      {weekKeywords.length === 0 ? (
        <div class="empty-note">주차별 키워드 데이터가 없습니다.</div>
      ) : (
        <div class="week-grid">
          {weekKeywords.map((wk) => (
            <div class="week-panel">
              <div class="wp-head">
                <span class="wp-label">{wk.label}</span>
                <span class="wp-count">{wk.topics.length}개 토픽</span>
              </div>
              <div class="wp-topics">
                {wk.topics.slice(0, 20).map((topic) => (
                  <details class="wt-item">
                    <summary class="wt-row">
                      <span class="wt-kw">{topic.keyword}</span>
                      <span class="wt-n">{topic.count}</span>
                    </summary>
                    <div class="kw-members wt-members">
                      {topic.members.map((m) => (
                        <a
                          href={`/member/${encodeURIComponent(m.team)}/${encodeURIComponent(m.nickname)}/`}
                          class="member-chip"
                        >
                          <span class="mc-team">{m.team}</span>
                          <span class="mc-name">{m.nickname}</span>
                        </a>
                      ))}
                    </div>
                  </details>
                ))}
                {wk.topics.length > 20 && (
                  <div class="wp-more">+ {wk.topics.length - 20}개 더</div>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- ═══ 뒤로 ═══ -->
    <div class="back-row">
      <a href="/" class="back-link">← 홈으로</a>
    </div>

    <footer class="mag-footer">
      <div class="fo-bot">
        <span>스폰지클럽 — 매주 만들고, 각자 나눈다</span>
        <span>종합 {overallTopics.length}개 키워드</span>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* ─── 요약 헤더 ─────────────────────────────── */
  .kw-summary {
    margin-top: clamp(36px, 6vh, 72px);
    background: var(--fg);
    color: var(--white);
    border: 4px solid var(--fg);
    box-shadow: var(--sh-l);
    padding: clamp(24px, 3.2vw, 48px);
  }

  .kws-label {
    display: inline-block;
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--key);
    color: var(--fg);
    border: 2px solid var(--fg);
    padding: 5px 10px;
    margin-bottom: 18px;
  }

  .kws-body {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.6vw, 18px);
    font-weight: 500;
    line-height: 1.7;
    color: var(--white);
    max-width: 700px;
    margin-bottom: 28px;
  }
  .kws-body strong { font-weight: 900; color: var(--white); }
  .kws-top {
    font-family: var(--font-display);
    font-weight: 900;
    background: var(--key);
    color: var(--fg);
    padding: 0.02em 0.15em;
  }

  .kws-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 3px solid var(--white);
  }

  .kws-stat {
    padding: 20px 22px;
    border-right: 3px solid var(--white);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .kws-stat:last-child { border-right: none; }
  .kws-stat--key { background: var(--key); color: var(--fg); }
  .kws-stat--key .kws-n,
  .kws-stat--key .kws-l { color: var(--fg); }

  .kws-n {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.2vw, 44px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--white);
  }
  .kws-l {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.10em;
    color: rgba(255,255,255,0.7);
  }

  /* ─── 키워드 클라우드 ────────────────────────── */
  .kw-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    align-items: baseline;
    padding: 32px;
    border: 4px solid var(--fg);
    box-shadow: var(--sh-m);
    background: var(--white);
  }

  .kw-item {
    display: inline-block;
  }

  /* Tier-based chip appearance applied via data-tier attribute */
  .kw-item[data-tier="top"] > .kw-word {
    background: var(--key);
    border-color: var(--fg);
    box-shadow: var(--sh-s);
  }
  .kw-item[data-tier="mid"] > .kw-word {
    background: var(--white);
    border-color: var(--fg);
  }
  .kw-item[data-tier="low"] > .kw-word {
    background: var(--muted);
    border-color: var(--fg);
  }
  .kw-item[open] > .kw-word {
    background: var(--fg);
    color: var(--white);
    box-shadow: none;
    transform: translate(2px, 2px);
  }
  .kw-item[open] > .kw-word .kw-cnt {
    color: var(--key);
  }

  .kw-word {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--fg);
    cursor: pointer;
    list-style: none;
    border: 2px solid var(--fg);
    padding: 5px 10px;
    transition: transform 160ms ease-out, box-shadow 160ms ease-out, background 160ms ease-out;
  }
  .kw-word::-webkit-details-marker { display: none; }
  .kw-word::marker { display: none; }
  .kw-word:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--sh-s);
  }

  .kw-cnt {
    font-family: var(--font-label);
    font-size: 9px;
    font-weight: 900;
    color: var(--fg);
    letter-spacing: 0.04em;
    vertical-align: super;
    line-height: 1;
    opacity: 0.7;
  }

  .kw-members {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 12px 14px 14px;
    border-left: 4px solid var(--key);
    margin-top: 6px;
    background: var(--muted);
    border-top: 2px solid var(--fg);
    border-right: 2px solid var(--fg);
    border-bottom: 2px solid var(--fg);
  }

  /* ─── 멤버 칩 ────────────────────────────────── */
  .member-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border: 2px solid var(--fg);
    border-radius: 9999px;
    background: var(--white);
    text-decoration: none;
    transition: transform 160ms ease-out, box-shadow 160ms ease-out, background 160ms ease-out;
  }
  .member-chip:hover {
    background: var(--key);
    transform: translate(-2px, -2px);
    box-shadow: var(--sh-s);
  }
  .mc-team {
    font-family: var(--font-label);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
    opacity: 0.6;
  }
  .mc-name {
    font-size: 12px;
    color: var(--fg);
    font-weight: 600;
  }

  /* ─── 주차별 그리드 ──────────────────────────── */
  .week-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
  }

  .week-panel {
    border: 4px solid var(--fg);
    box-shadow: var(--sh-m);
    background: var(--white);
    overflow: hidden;
    transition: transform 200ms ease-out, box-shadow 200ms ease-out;
  }
  .week-panel:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--sh-l);
  }

  .wp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 4px solid var(--fg);
    background: var(--fg);
    color: var(--white);
  }
  .wp-label {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--white);
  }
  .wp-count {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--key);
    color: var(--fg);
    border: 2px solid var(--fg);
    padding: 3px 8px;
  }

  .wp-topics {
    padding: 10px 0;
  }

  .wt-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 18px;
    cursor: pointer;
    list-style: none;
    border-bottom: 2px solid var(--muted);
    transition: background 150ms ease-out;
    gap: 12px;
  }
  .wt-row::-webkit-details-marker { display: none; }
  .wt-row::marker { display: none; }
  .wt-row:hover { background: var(--muted); }
  .wt-item[open] > .wt-row {
    background: var(--key);
    border-bottom-color: var(--fg);
  }
  .wt-kw {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--fg);
    flex: 1;
  }
  .wt-n {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 900;
    color: var(--fg);
    background: var(--white);
    border: 2px solid var(--fg);
    padding: 2px 7px;
    flex-shrink: 0;
  }
  .wt-item[open] > .wt-row .wt-n {
    background: var(--fg);
    color: var(--key);
  }

  .wt-members {
    margin: 0 14px 10px;
  }

  .wp-more {
    padding: 8px 18px;
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
    opacity: 0.5;
  }

  /* ─── 뒤로 링크 ──────────────────────────────── */
  .back-row {
    margin-top: 72px;
    padding-top: 28px;
    border-top: 4px solid var(--fg);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg);
    background: var(--white);
    border: 3px solid var(--fg);
    box-shadow: var(--sh-s);
    padding: 10px 16px;
    transition: transform 180ms ease-out, box-shadow 180ms ease-out, background 160ms ease-out;
  }
  .back-link:hover {
    background: var(--key);
    transform: translate(-2px, -2px);
    box-shadow: var(--sh-m);
  }

  /* ─── 반응형 ─────────────────────────────────── */
  @media (max-width: 760px) {
    .kws-stats { grid-template-columns: repeat(2, 1fr); }
    .kws-stat:nth-child(2) { border-right: none; }
    .kws-stat:nth-child(1),
    .kws-stat:nth-child(2) { border-bottom: 3px solid var(--white); }
  }
  @media (max-width: 600px) {
    .kw-cloud { padding: 20px 16px; gap: 8px 10px; }
    .week-grid { grid-template-columns: 1fr; }
    .kws-stats { grid-template-columns: 1fr 1fr; }
  }
</style>
