---
import Layout from '../layouts/Layout.astro';
import {
  buildAllWeeks,
  groupByTeam,
  getTeamTopic,
  noteUrl,
  type Submission,
} from '../lib/data';

const weeks = buildAllWeeks();
const teams = ['1조', '2조', '3조', '4조', '5조', '6조'];

const submissionUrl = (s: Submission, weekNumber: number) =>
  s.filePath ? noteUrl(s, weekNumber) : '#';

const statusText = (s: Submission) =>
  s.status === 'submitted' ? '제출' : s.status === 'drafting' ? '작성 중' : '미작성';

const latestIdx = weeks.length - 1;
---

<Layout title="현황판 — 스폰지클럽" bodyClass="sc-page">
  <header class="sc-header">
    <div class="sc-header-inner">
      <a href="/" class="sc-brand">
        <span class="sc-brand-mark">🧽</span>
        <span class="sc-brand-name">spongeclub</span>
        <span class="sc-brand-sep">/</span>
        <span class="sc-brand-sub">현황판</span>
      </a>
      <nav class="sc-nav" aria-label="메인 메뉴">
        <a href="/">매거진</a>
        <a href="/board/" class="active">현황판</a>
        <a href="/keywords/">키워드</a>
        <a href="/skills/">스킬</a>
        <a href="/gallery/">갤러리</a>
      </nav>
    </div>
  </header>

  {weeks.length === 0 && (
    <main class="sc-main">
      <div class="bd-empty">아직 미션 데이터가 없습니다.</div>
    </main>
  )}

  {weeks.length > 0 && (
    <main class="sc-main">
      <section class="sc-title-section">
        <p class="sc-kicker">매주 누가 제출했나</p>
        <h1 class="sc-h1">
          <span class="sc-shape sc-shape--square" aria-hidden="true"></span>
          현황판
        </h1>
        <p class="sc-lede">
          주차별로 6개 조 <span class="sc-highlight">72명의 제출 상태</span>를 한눈에.
        </p>
      </section>

      <!-- 주차 탭 -->
      <nav id="week-tabs" class="bd-tabs" aria-label="주차">
        {weeks.map((w, i) => (
          <button
            data-week-idx={i}
            data-active={i === latestIdx ? 'true' : 'false'}
            class="bd-tab"
          >
            <span>{w.weekNumber}주차</span>
            {w.dateLabel && <span class="bd-tab-date">{w.dateLabel}</span>}
          </button>
        ))}
      </nav>

      <!-- 통계 + 뷰 토글 -->
      <div class="bd-toolbar">
        <div class="bd-summary">
          <span id="week-summary" class="bd-summary-text"></span>
          <span class="bd-legend">
            <span class="bd-legend-item"><span class="bd-dot bd-dot--done"></span>제출</span>
            <span class="bd-legend-item"><span class="bd-dot bd-dot--draft"></span>작성 중</span>
            <span class="bd-legend-item"><span class="bd-dot bd-dot--empty"></span>미작성</span>
          </span>
        </div>
        <div id="view-toggle" class="bd-view-toggle">
          <button data-view="team" class="bd-view-btn" data-active="true">조별</button>
          <button data-view="all" class="bd-view-btn" data-active="false">전체</button>
        </div>
      </div>

      {weeks.map((week, i) => {
        const grouped = groupByTeam(week.submissions);
        return (
          <section data-week-panel={i} class={i === latestIdx ? 'bd-panel' : 'bd-panel bd-hidden'}>
            <div class="bd-progress-grid">
              {teams.map((team) => {
                const subs = grouped.get(team) ?? [];
                const done = subs.filter((s: Submission) => s.status === 'submitted').length;
                const drafting = subs.filter((s: Submission) => s.status === 'drafting').length;
                const total = subs.length;
                const pct = total === 0 ? 0 : Math.round((done / total) * 100);
                return (
                  <div class="bd-progress">
                    <div class="bd-progress-head">
                      <span class="bd-progress-team">{team}</span>
                      <span class="bd-progress-pct">
                        {pct}%
                        {drafting > 0 && <span class="bd-progress-draft">+{drafting}</span>}
                      </span>
                    </div>
                    <div class="bd-progress-bar">
                      <div class="bd-progress-fill" style={`width: ${pct}%`}></div>
                    </div>
                  </div>
                );
              })}
            </div>

            <!-- 조별 -->
            <div data-view-panel="team" class="bd-team-grid">
              {teams.map((team) => {
                const subs = grouped.get(team) ?? [];
                const done = subs.filter((s: Submission) => s.status === 'submitted').length;
                const total = subs.length;
                const topic = getTeamTopic(team);
                return (
                  <article class="bd-team-card">
                    <header class="bd-team-card-head">
                      <div class="bd-team-card-info">
                        <span class="bd-team-card-team">{team}</span>
                        {topic && <span class="bd-team-card-topic">{topic.topic}</span>}
                      </div>
                      <span class="bd-team-card-pct">{total === 0 ? 0 : Math.round((done / total) * 100)}%</span>
                    </header>
                    <ul class="bd-team-card-list">
                      {subs.map((s: Submission) => (
                        <li>
                          <a
                            href={submissionUrl(s, week.weekNumber)}
                            class={`bd-row bd-row--${s.status}`}
                          >
                            <span class={`bd-dot bd-dot--${s.status === 'submitted' ? 'done' : s.status === 'drafting' ? 'draft' : 'empty'}`}></span>
                            <span class="bd-row-name">{s.member.nickname}</span>
                            {s.member.isCrew && <span class="bd-row-crew">크루</span>}
                            <span class="bd-row-status">{statusText(s)}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </article>
                );
              })}
            </div>

            <!-- 전체 -->
            <div data-view-panel="all" class="bd-all-grid bd-hidden">
              {week.submissions.map((s) => (
                <a
                  href={submissionUrl(s, week.weekNumber)}
                  class={`bd-tile bd-tile--${s.status}`}
                  title={s.noteTitle ?? s.member.nickname}
                >
                  <span class={`bd-dot bd-dot--${s.status === 'submitted' ? 'done' : s.status === 'drafting' ? 'draft' : 'empty'} bd-tile-dot`}></span>
                  <span class="bd-tile-name">{s.member.nickname}</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}

      <div class="bd-folder-foot" id="week-folder"></div>
    </main>
  )}

  <footer class="sc-footer">
    스폰지클럽 — 매주 만들고, 각자 나눈다
  </footer>

  <script
    is:inline
    define:vars={{
      summaryPerWeek: weeks.map((w) => ({
        submitted: w.submittedCount,
        drafting: w.submissions.filter((s) => s.status === 'drafting').length,
        total: w.totalMembers,
        folder: w.folderName,
      })),
    }}
  >
    const tabs = document.querySelectorAll('.bd-tab');
    const panels = document.querySelectorAll('[data-week-panel]');
    const summaryEl = document.getElementById('week-summary');
    const folderEl = document.getElementById('week-folder');

    function renderSummary(idx) {
      const s = summaryPerWeek[idx];
      if (!s || !summaryEl) return;
      summaryEl.innerHTML =
        `<b>${s.submitted}</b> / ${s.total} 제출` +
        (s.drafting > 0 ? ` · <b class="bd-draft-num">${s.drafting} 작성 중</b>` : '');
      if (folderEl) folderEl.textContent = s.folder;
    }

    function selectWeek(idx) {
      tabs.forEach((t) => {
        t.setAttribute('data-active', String(Number(t.getAttribute('data-week-idx')) === idx));
      });
      panels.forEach((p) => {
        const isActive = Number(p.getAttribute('data-week-panel')) === idx;
        p.classList.toggle('bd-hidden', !isActive);
      });
      renderSummary(idx);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        selectWeek(Number(tab.getAttribute('data-week-idx')));
      });
    });

    const viewBtns = document.querySelectorAll('.bd-view-btn');
    viewBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-view');
        viewBtns.forEach((b) =>
          b.setAttribute('data-active', String(b.getAttribute('data-view') === target))
        );
        document.querySelectorAll('[data-view-panel]').forEach((panel) => {
          const isActive = panel.getAttribute('data-view-panel') === target;
          panel.classList.toggle('bd-hidden', !isActive);
        });
      });
    });

    const initialActive = Array.from(tabs).find((t) => t.getAttribute('data-active') === 'true');
    if (initialActive) renderSummary(Number(initialActive.getAttribute('data-week-idx')));
  </script>
</Layout>

<style is:global>
  .bd-empty { padding: 80px 0; text-align: center; color: var(--sc-text-muted-mid); }
  .bd-hidden { display: none !important; }

  /* tabs */
  .bd-tabs {
    display: flex; flex-wrap: wrap; gap: 6px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--sc-border-soft);
  }
  .bd-tab {
    padding: 8px 14px;
    border-radius: var(--sc-radius-pill);
    border: 1px solid transparent;
    font-size: 13px;
    font-weight: 500;
    color: var(--sc-text-muted-mid);
    transition: all 140ms;
  }
  .bd-tab:hover { color: var(--sc-text-primary); background: var(--sc-border-soft); }
  .bd-tab[data-active="true"] {
    background: var(--sc-surface-dark);
    color: var(--sc-text-on-dark);
    border-color: var(--sc-surface-dark);
    font-weight: 700;
  }
  .bd-tab-date {
    font-size: 11px;
    opacity: 0.7;
    margin-left: 6px;
    font-variant-numeric: tabular-nums;
  }

  /* toolbar */
  .bd-toolbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .bd-summary { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .bd-summary-text { font-size: 14px; color: var(--sc-text-muted-high); }
  .bd-summary-text b { color: var(--sc-text-primary); font-weight: 700; }
  .bd-draft-num { color: var(--sc-accent-red); }
  .bd-legend { display: flex; gap: 12px; font-size: 12px; color: var(--sc-text-muted-mid); }
  .bd-legend-item { display: inline-flex; align-items: center; gap: 5px; }
  .bd-dot { width: 8px; height: 8px; border-radius: 999px; flex-shrink: 0; }
  .bd-dot--done { background: #1F7A3A; }
  .bd-dot--draft, .bd-dot--drafting { background: var(--sc-accent-yellow); }
  .bd-dot--empty { background: var(--sc-text-muted-low); }
  .bd-dot--submitted { background: #1F7A3A; }

  .bd-view-toggle {
    display: inline-flex;
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-pill);
    background: var(--sc-surface-white);
    padding: 3px;
  }
  .bd-view-btn {
    padding: 6px 14px;
    border-radius: var(--sc-radius-pill);
    font-size: 13px;
    font-weight: 600;
    color: var(--sc-text-muted-mid);
    transition: all 140ms;
  }
  .bd-view-btn[data-active="true"] {
    background: var(--sc-surface-dark);
    color: var(--sc-text-on-dark);
  }

  .bd-panel { display: flex; flex-direction: column; gap: 28px; }

  /* progress grid */
  .bd-progress-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 10px;
  }
  .bd-progress {
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    padding: 14px;
  }
  .bd-progress-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .bd-progress-team { font-size: 13px; font-weight: 700; color: var(--sc-text-primary); }
  .bd-progress-pct { font-size: 12px; color: var(--sc-text-muted-mid); font-variant-numeric: tabular-nums; }
  .bd-progress-draft { color: var(--sc-accent-red); margin-left: 4px; font-weight: 700; }
  .bd-progress-bar { height: 6px; background: var(--sc-border-soft); border-radius: 999px; overflow: hidden; }
  .bd-progress-fill { height: 100%; background: var(--sc-accent-red); transition: width 320ms; }

  @media (max-width: 900px) { .bd-progress-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 540px) { .bd-progress-grid { grid-template-columns: repeat(2, 1fr); } }

  /* team grid */
  .bd-team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .bd-team-card {
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-card);
    overflow: hidden;
  }
  .bd-team-card-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px;
    border-bottom: 1px solid var(--sc-border-soft);
  }
  .bd-team-card-info { display: flex; align-items: baseline; gap: 8px; min-width: 0; }
  .bd-team-card-team { font-weight: 700; font-size: 15px; color: var(--sc-text-primary); }
  .bd-team-card-topic { font-size: 12px; color: var(--sc-text-muted-mid); truncate: true; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bd-team-card-pct { font-weight: 700; font-size: 14px; color: var(--sc-text-primary); }
  .bd-team-card-list li { border-bottom: 1px solid var(--sc-border-soft); }
  .bd-team-card-list li:last-child { border-bottom: none; }
  .bd-row {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 16px;
    transition: background 140ms;
  }
  .bd-row:hover { background: var(--sc-border-soft); }
  .bd-row--empty { opacity: 0.5; }
  .bd-row-name { font-size: 13px; font-weight: 600; color: var(--sc-text-primary); }
  .bd-row-crew { font-size: 10px; padding: 2px 6px; border-radius: 4px; background: var(--sc-border-soft); color: var(--sc-text-muted-mid); }
  .bd-row-status { margin-left: auto; font-size: 12px; color: var(--sc-text-muted-mid); }

  @media (max-width: 900px) { .bd-team-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .bd-team-grid { grid-template-columns: 1fr; } }

  /* all-view grid */
  .bd-all-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 6px;
  }
  .bd-all-grid.bd-hidden { display: none !important; }
  .bd-tile {
    aspect-ratio: 1;
    background: var(--sc-surface-white);
    border: 1px solid var(--sc-border-card);
    border-radius: var(--sc-radius-small);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    position: relative;
    padding: 4px;
    transition: border-color 140ms, transform 140ms;
  }
  .bd-tile:hover { border-color: var(--sc-text-primary); transform: translateY(-2px); }
  .bd-tile--empty { opacity: 0.4; }
  .bd-tile-dot { position: absolute; top: 5px; right: 5px; width: 6px; height: 6px; }
  .bd-tile-name { font-size: 11px; font-weight: 600; color: var(--sc-text-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }

  @media (max-width: 1080px) { .bd-all-grid { grid-template-columns: repeat(8, 1fr); } }
  @media (max-width: 720px) { .bd-all-grid { grid-template-columns: repeat(6, 1fr); } }
  @media (max-width: 480px) { .bd-all-grid { grid-template-columns: repeat(4, 1fr); } }

  .bd-folder-foot {
    text-align: center;
    font-size: 11px;
    color: var(--sc-text-muted-low);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
</style>
