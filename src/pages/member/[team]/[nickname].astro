---
import Layout from '../../../layouts/Layout.astro';
import { loadAnalysis, getMemberAnalysis, weekLabel, type MemberAnalysis } from '../../../lib/analysis';
import { getTeamTopic } from '../../../lib/data';

export async function getStaticPaths() {
  const { members } = loadAnalysis();
  return members.map((m) => ({
    params: { team: m.team, nickname: m.nickname },
    props: { member: m },
  }));
}

interface Props {
  member: MemberAnalysis;
}

const { member } = Astro.props as Props;
const teamInfo = getTeamTopic(member.team);
---

<Layout
  title={`${member.nickname} 성장기록 | 스폰지클럽`}
  description={member.growthNarrative.slice(0, 120)}
  bodyClass="mag"
>
  <nav class="nav">
    <div class="wrap nav-inner">
      <a href="/" class="brand">
        <span class="brand-shapes" aria-hidden="true">
          <span class="s-c"></span><span class="s-s"></span><span class="s-t"></span>
        </span>
        <span>스폰지클럽</span>
      </a>
      <div class="nav-links">
        <a href="/board/">현황판</a>
        <a href="/keywords/">키워드</a>
        <a href="/skills/">스킬모음</a>
        <a href="/gallery/">갤러리</a>
      </div>
    </div>
  </nav>

  <main class="wrap">
    <!-- Back link -->
    <div class="mem-back reveal">
      <a href="/board/" class="mem-back-link">← 현황판으로</a>
    </div>

    <!-- Member Header -->
    <header class="mem-header reveal d1">
      <div class="mem-kicker">
        <span class="mem-team">{member.team}</span>
        {teamInfo && (
          <span class="mem-topic">{teamInfo.topic}</span>
        )}
      </div>
      <h1 class="mem-name">
        {member.nickname}
        {member.fullName !== member.nickname && (
          <span class="mem-fullname">({member.fullName})</span>
        )}
      </h1>
    </header>

    <!-- Summary Stat Strip -->
    <div class="mem-stats reveal d2">
      <div class="mem-stat">
        <span class="ms-n">{member.weeklyHighlights.length}</span>
        <span class="ms-l">Weeks</span>
      </div>
      <div class="mem-stat">
        <span class="ms-n">{member.keywords.length}</span>
        <span class="ms-l">Keywords</span>
      </div>
      <div class="mem-stat mem-stat--team">
        <span class="ms-n">{member.team}</span>
        <span class="ms-l">Team</span>
      </div>
      {teamInfo && (
        <div class="mem-stat mem-stat--topic">
          <span class="ms-n ms-n--sm">{teamInfo.topic}</span>
          <span class="ms-l">Topic</span>
        </div>
      )}
    </div>

    <!-- Growth Narrative -->
    <section class="mem-narrative reveal d2">
      <div class="s-num">성장 아크</div>
      <blockquote class="mem-quote">{member.growthNarrative}</blockquote>
    </section>

    <!-- Keywords -->
    {member.keywords.length > 0 && (
      <section class="mem-keywords reveal d3">
        <div class="s-num">핵심 키워드</div>
        <div class="mem-chips">
          {member.keywords.map((kw) => (
            <span class="mem-chip">{kw}</span>
          ))}
        </div>
      </section>
    )}

    <!-- Weekly Timeline -->
    {member.weeklyHighlights.length > 0 && (
      <section class="s reveal d4">
        <div class="s-head">
          <div>
            <div class="s-num">주차별 기록</div>
            <h2 class="s-title">Timeline</h2>
          </div>
        </div>
        <ol class="mem-timeline">
          {member.weeklyHighlights.map((wh) => (
            <li class="mem-week">
              <div class="mw-label">{weekLabel(wh.week)}</div>
              <div class="mw-body">
                <div class="mw-title">{wh.title}</div>
                <p class="mw-summary">{wh.summary}</p>
                {wh.keywords.length > 0 && (
                  <div class="mw-chips">
                    {wh.keywords.map((kw) => (
                      <span class="a-chip">{kw}</span>
                    ))}
                  </div>
                )}
                <a
                  href={`/w/${wh.week}/${encodeURIComponent(member.team)}/${encodeURIComponent(member.nickname)}/`}
                  class="mw-link"
                >
                  전체 노트 읽기 →
                </a>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Footer spacer -->
    <div style="height: 100px;"></div>
  </main>
</Layout>

<style>
  /* ── Back ── */
  .mem-back {
    padding-top: clamp(28px, 5vw, 48px);
    padding-bottom: 12px;
  }
  .mem-back-link {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--fg);
    border-bottom: 2px solid var(--fg);
    padding-bottom: 2px;
    transition: background 160ms ease-out, padding 160ms ease-out;
    display: inline-block;
  }
  .mem-back-link:hover {
    background: var(--key);
    padding-inline: 6px;
    border-bottom-color: var(--fg);
  }

  /* ── Header ── */
  .mem-header {
    padding-top: clamp(32px, 5vw, 56px);
    padding-bottom: 36px;
    border-bottom: 4px solid var(--fg);
  }
  .mem-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }
  .mem-team {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
    background: var(--key);
    border: 2px solid var(--fg);
    box-shadow: var(--sh-s);
    padding: 5px 11px;
  }
  .mem-topic {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--white);
    background: var(--fg);
    padding: 5px 11px;
  }
  .mem-name {
    font-family: var(--font-display);
    font-size: clamp(48px, 8vw, 96px);
    line-height: 0.96;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--fg);
  }
  .mem-fullname {
    font-family: var(--font-label);
    font-size: clamp(14px, 1.8vw, 18px);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--fg);
    vertical-align: middle;
    margin-left: 14px;
    background: var(--muted);
    border: 2px solid var(--fg);
    padding: 3px 10px;
  }

  /* ── Summary Stat Strip ── */
  .mem-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: var(--key);
    border: 4px solid var(--fg);
    box-shadow: var(--sh-l);
    margin-top: 32px;
  }
  .mem-stat {
    padding: 22px 20px;
    border-right: 4px solid var(--fg);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mem-stat:last-child { border-right: none; }
  .mem-stat--team { background: var(--fg); color: var(--white); }
  .mem-stat--topic { background: var(--white); }
  .ms-n {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 56px);
    line-height: 0.9;
    font-weight: 900;
    letter-spacing: -0.04em;
  }
  .ms-n--sm {
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .ms-l {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.10em;
  }
  .mem-stat--team .ms-l { color: var(--key); }

  /* ── Narrative ── */
  .mem-narrative {
    padding-top: clamp(48px, 6vw, 72px);
    padding-bottom: 8px;
  }
  .mem-narrative .s-num { margin-bottom: 18px; }
  .mem-quote {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 900;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.5;
    color: var(--fg);
    border-left: 6px solid var(--red);
    padding: 20px 0 20px 28px;
    margin: 0;
    max-width: 820px;
  }

  /* ── Keywords ── */
  .mem-keywords {
    padding-top: clamp(40px, 5vw, 60px);
  }
  .mem-keywords .s-num { margin-bottom: 14px; }
  .mem-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .mem-chip {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
    background: var(--white);
    border: 2px solid var(--fg);
    box-shadow: var(--sh-s);
    padding: 6px 13px;
    transition: transform 160ms ease-out, box-shadow 160ms ease-out, background 160ms ease-out;
  }
  .mem-chip:hover {
    background: var(--key);
    transform: translate(-2px, -2px);
    box-shadow: var(--sh-m);
  }

  /* ── Timeline ── */
  .mem-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .mem-week {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 32px;
    padding: 32px 0;
    border-bottom: 4px solid var(--fg);
    align-items: start;
  }
  .mem-week:last-child { border-bottom: none; }
  .mw-label {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
    background: var(--key);
    border: 2px solid var(--fg);
    box-shadow: var(--sh-s);
    padding: 7px 10px;
    position: sticky;
    top: 82px;
    align-self: start;
    text-align: center;
  }
  .mw-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mw-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--fg);
  }
  .mw-summary {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--fg);
    line-height: 1.68;
    margin: 0;
    max-width: 680px;
  }
  .mw-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  /* reuse .a-chip from global */
  .mw-link {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--fg);
    background: var(--white);
    border: 2px solid var(--fg);
    box-shadow: var(--sh-s);
    padding: 8px 14px;
    align-self: flex-start;
    display: inline-block;
    transition: transform 160ms ease-out, box-shadow 160ms ease-out, background 160ms ease-out;
  }
  .mw-link:hover {
    background: var(--blue);
    color: var(--white);
    transform: translate(-2px, -2px);
    box-shadow: var(--sh-m);
  }

  /* ── Responsive ── */
  @media (max-width: 760px) {
    .mem-stats { grid-template-columns: repeat(2, 1fr); }
    .mem-stat:nth-child(2) { border-right: none; }
    .mem-stat:nth-child(1),
    .mem-stat:nth-child(2) { border-bottom: 4px solid var(--fg); }
  }
  @media (max-width: 600px) {
    .mem-week {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .mw-label { position: static; text-align: left; }
    .mem-stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
