---
import Layout from '../layouts/Layout.astro';
import { loadCuratedSkills, groupByCategory, type CuratedSkill } from '../lib/curated-skills';

const skills = loadCuratedSkills();
const groups = groupByCategory(skills);

const CATEGORY_META: Record<string, { num: string; titleA: string; titleB: string; desc: string }> = {
  '클로드코드': {
    num: '01',
    titleA: '클로드',
    titleB: '코드',
    desc: 'Claude Code 자체를 더 잘 쓰게 해주는 스킬·플러그인',
  },
  '콘텐츠마케팅': {
    num: '02',
    titleA: '콘텐츠·',
    titleB: '마케팅',
    desc: '카드뉴스, 영상, 블로그, 캐러셀까지 — 결과물을 만들어내는 스킬',
  },
  '개발도구': {
    num: '03',
    titleA: '개발·',
    titleB: '도구',
    desc: '코드 작업 흐름을 매끄럽게 해주는 MCP·에이전트 도구',
  },
  '생산성': {
    num: '04',
    titleA: '생산',
    titleB: '성',
    desc: '문서·프레젠테이션·운영 자동화 도구',
  },
};

function hostLabel(url: string): string {
  try { return new URL(url).hostname.replace(/^www\./, ''); }
  catch { return url.slice(0, 40); }
}

const totalReviewed = skills.filter((s) => s.postType === '써본후기').length;
const totalShared = skills.filter((s) => s.postType === '공유').length;
---

<Layout title="스킬 모음 — 스폰지클럽" bodyClass="mag">
  <!-- ═══ NAV ═══ -->
  <nav class="nav">
    <div class="wrap nav-inner">
      <a href="/" class="brand">
        <span class="brand-shapes" aria-hidden="true">
          <span class="s-c"></span><span class="s-s"></span><span class="s-t"></span>
        </span>
        <span>스폰지클럽</span>
      </a>
      <div class="nav-links">
        <a href="/board/">현황판</a>
        <a href="/keywords/">키워드</a>
        <a href="/skills/" aria-current="page">스킬모음</a>
        <a href="/gallery/">갤러리</a>
      </div>
    </div>
  </nav>

  <main class="wrap">
    <!-- ═══ SUMMARY HEADER ═══ -->
    <div class="skills-summary reveal d1">
      <div class="ss-label">PAGE OVERVIEW</div>
      <div class="ss-body">
        <p class="ss-lead">
          데굴데굴 조가 큐레이션한 <strong>{skills.length}개</strong>의 스킬·도구·가이드 —
          멤버들이 직접 써본 후기 <strong>{totalReviewed}건</strong>과 공유 자료 <strong>{totalShared}건</strong>을 카테고리별로 정리했습니다.
        </p>
        <div class="ss-stats">
          {groups.map((g) => (
            <div class="ss-stat">
              <span class="ss-n">{g.items.length}</span>
              <span class="ss-l">{g.category}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- page header -->
    <section class="s" style="padding-top: clamp(40px, 7vh, 72px);">
      <div class="s-head">
        <div>
          <div class="s-num">데굴데굴 큐레이션</div>
          <h1 class="s-title">스킬&nbsp;<em>모음</em></h1>
        </div>
        <p class="s-desc">
          멤버들이 실제로 써본 후기와 공유한 스킬·도구를 모았습니다.
          총 <strong>{skills.length}개</strong>.
        </p>
      </div>

      <!-- category jump nav -->
      <div class="cat-tabs">
        {groups.map((g) => {
          const meta = CATEGORY_META[g.category] ?? { num: '·', titleA: g.category, titleB: '' };
          return (
            <a href={`#${encodeURIComponent(g.category)}`} class="cat-tab">
              <span class="ct-num">{meta.num}</span>
              <span class="ct-label">{g.category}</span>
              <span class="ct-count">{g.items.length}</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- category sections -->
    {groups.map((g) => {
      const meta = CATEGORY_META[g.category] ?? { num: '·', titleA: g.category, titleB: '', desc: '' };
      return (
        <section class="s" id={g.category}>
          <div class="s-head">
            <div>
              <div class="s-num">SECTION {meta.num}</div>
              <h2 class="s-title">{meta.titleA}<em>{meta.titleB}</em></h2>
            </div>
            <p class="s-desc">{meta.desc}</p>
          </div>

          <div class="skills-grid">
            {g.items.map((sk: CuratedSkill) => (
              <article class="skill-card" id={sk.slug}>
                <header class="sc-head">
                  <div class="sc-badges">
                    <span class={`sc-badge sc-badge-${sk.postType === '써본후기' ? 'review' : 'share'}`}>
                      {sk.postType || '공유'}
                    </span>
                    {sk.difficulty && <span class="sc-badge sc-badge-diff">{sk.difficulty}</span>}
                  </div>
                  <h3 class="sc-title">{sk.skillName || sk.title}</h3>
                  {sk.summary && <p class="sc-summary">{sk.summary}</p>}
                </header>

                <div class="sc-meta">
                  {sk.authors.length > 0 && (
                    <div class="sc-meta-row">
                      <span class="sc-meta-key">{sk.postType === '써본후기' ? '써본 멤버' : '추천'}</span>
                      <span class="sc-meta-val">{sk.authors.join(' · ')}</span>
                    </div>
                  )}
                  {sk.audience.length > 0 && (
                    <div class="sc-meta-row">
                      <span class="sc-meta-key">대상</span>
                      <span class="sc-meta-val">{sk.audience.join(' · ')}</span>
                    </div>
                  )}
                  {sk.inspiredBy && (
                    <div class="sc-meta-row">
                      <span class="sc-meta-key">계기</span>
                      <span class="sc-meta-val">{sk.inspiredBy}</span>
                    </div>
                  )}
                </div>

                <div class="sc-body" set:html={sk.bodyHtml}></div>

                {sk.keywords.length > 0 && (
                  <div class="sc-keywords">
                    {sk.keywords.map((k) => (
                      <span class="sc-kw">#{k}</span>
                    ))}
                  </div>
                )}

                {sk.links.length > 0 && (
                  <footer class="sc-foot">
                    {sk.links.map((url) => (
                      <a href={url} target="_blank" rel="noopener noreferrer" class="sc-link">
                        <span class="sc-link-host">{hostLabel(url)}</span>
                        <span class="sc-link-arr">↗</span>
                      </a>
                    ))}
                  </footer>
                )}
              </article>
            ))}
          </div>
        </section>
      );
    })}

    <footer class="mag-footer">
      <div class="fo-bot">
        <span>스폰지클럽 — 매주 만들고, 각자 나눈다</span>
        <span>총 {skills.length}개 스킬 · 데굴데굴 큐레이션</span>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* ─── SUMMARY HEADER ─────────────────────────── */
  .skills-summary {
    margin-top: clamp(32px, 5vh, 56px);
    background: var(--key);
    border: 4px solid var(--fg);
    box-shadow: var(--sh-l);
  }
  .ss-label {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--fg);
    color: var(--white);
    padding: 7px 14px;
    display: inline-block;
  }
  .ss-body {
    padding: clamp(20px, 3vw, 36px) clamp(20px, 3vw, 36px) clamp(24px, 3.5vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .ss-lead {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.6vw, 18px);
    font-weight: 600;
    line-height: 1.6;
    color: var(--fg);
    max-width: 720px;
  }
  .ss-lead strong {
    font-family: var(--font-display);
    font-size: 1.1em;
    font-weight: 900;
    letter-spacing: -0.03em;
  }
  .ss-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    border: 3px solid var(--fg);
    background: var(--white);
  }
  .ss-stat {
    padding: 18px 20px;
    border-right: 3px solid var(--fg);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ss-stat:last-child { border-right: none; }
  .ss-n {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--fg);
  }
  .ss-l {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg);
  }

  /* ─── category jump tabs ─────────────────────── */
  .cat-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .cat-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 2px solid var(--fg);
    background: var(--white);
    box-shadow: var(--sh-s);
    text-decoration: none;
    transition: transform 160ms ease-out, box-shadow 160ms ease-out, background 160ms ease-out;
  }
  .cat-tab:hover {
    background: var(--key);
    transform: translate(-2px, -2px);
    box-shadow: var(--sh-m);
  }
  .ct-num {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .ct-label {
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 700;
    color: var(--fg);
  }
  .ct-count {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 900;
    color: var(--fg);
    background: var(--key);
    border: 2px solid var(--fg);
    padding: 1px 7px;
  }

  /* ─── skill cards ────────────────────────────── */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .skill-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 22px;
    background: var(--white);
    border: 3px solid var(--fg);
    box-shadow: var(--sh-m);
    scroll-margin-top: 80px;
  }
  .sc-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sc-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .sc-badge {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 4px 9px;
    border: 2px solid var(--fg);
    text-transform: none;
  }
  .sc-badge-review { background: var(--key); color: var(--fg); }
  .sc-badge-share  { background: var(--fg); color: var(--white); }
  .sc-badge-diff   { background: var(--white); color: var(--fg); }

  .sc-title {
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin: 0;
    word-break: break-word;
  }
  .sc-summary {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--fg);
    margin: 0;
  }

  .sc-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 14px;
    background: #f7f7f4;
    border: 2px solid var(--fg);
  }
  .sc-meta-row {
    display: flex;
    gap: 10px;
    font-size: 12px;
    line-height: 1.5;
  }
  .sc-meta-key {
    font-family: var(--font-label);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
    min-width: 64px;
    flex-shrink: 0;
  }
  .sc-meta-val {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--fg);
  }

  .sc-body {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--fg);
  }
  .sc-body :global(h2) {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 14px 0 6px;
    color: var(--fg);
  }
  .sc-body :global(h2:first-child) { margin-top: 0; }
  .sc-body :global(ul) {
    padding-left: 18px;
    margin: 6px 0;
  }
  .sc-body :global(li) { margin: 3px 0; }
  .sc-body :global(blockquote) {
    margin: 8px 0;
    padding: 8px 12px;
    border-left: 3px solid var(--fg);
    background: #fffbe6;
    font-style: italic;
    font-size: 13px;
  }
  .sc-body :global(blockquote p) { margin: 0; }
  .sc-body :global(a) { color: var(--fg); text-decoration: underline; }

  .sc-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .sc-kw {
    font-family: var(--font-label);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--fg);
    background: transparent;
    border: 1.5px solid var(--fg);
    padding: 2px 8px;
  }

  .sc-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sc-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 14px;
    border: 2px solid var(--fg);
    background: var(--fg);
    color: var(--white);
    text-decoration: none;
    transition: transform 140ms ease-out, box-shadow 140ms ease-out;
  }
  .sc-link:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--fg);
  }
  .sc-link-host {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    word-break: break-all;
  }
  .sc-link-arr {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 16px;
  }

  /* ─── responsive ─────────────────────────────── */
  @media (max-width: 760px) {
    .ss-stats { grid-template-columns: repeat(2, 1fr); }
    .ss-stat:nth-child(even) { border-right: none; }
    .ss-stat:not(:nth-last-child(-n+2)) { border-bottom: 3px solid var(--fg); }
    .skills-grid { grid-template-columns: 1fr; }
  }
</style>
