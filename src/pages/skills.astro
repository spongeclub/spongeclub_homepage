---
import Layout from '../layouts/Layout.astro';
import { extractSharedLinks, type SharedLink } from '../lib/skills';

const links = extractSharedLinks();

const byCategory = (cat: string) =>
  links.filter((l: SharedLink) => l.category === cat);

const skill    = byCategory('skill');
const tool     = byCategory('tool');
const content  = byCategory('content');
const showcase = byCategory('showcase');

const sections: Array<{
  id: string;
  num: string;
  title: string;
  titleEm: string;
  desc: string;
  items: SharedLink[];
}> = [
  {
    id: 'skill',
    num: '01',
    title: '스킬·',
    titleEm: '레포',
    desc: '멤버들이 공유한 Claude 스킬, 플러그인, GitHub 레포지토리',
    items: skill,
  },
  {
    id: 'tool',
    num: '02',
    title: '도구·',
    titleEm: '서비스',
    desc: '실습에 활용된 SaaS, 생산성 툴, 플랫폼',
    items: tool,
  },
  {
    id: 'content',
    num: '03',
    title: '콘텐츠·',
    titleEm: '아티클',
    desc: '유튜브, 뉴스레터, 블로그 등 멤버들이 추천한 읽기·보기 자료',
    items: content,
  },
  {
    id: 'showcase',
    num: '04',
    title: '멤버',
    titleEm: '산출물',
    desc: '멤버들이 직접 배포한 사이트와 프로젝트',
    items: showcase,
  },
];

function hostLabel(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url.slice(0, 40);
  }
}
---

<Layout title="스킬 사이트 모음 — 스폰지클럽" bodyClass="mag">
  <!-- ═══ NAV ═══ -->
  <nav class="nav">
    <div class="wrap nav-inner">
      <a href="/" class="brand">
        <span class="brand-shapes" aria-hidden="true">
          <span class="s-c"></span><span class="s-s"></span><span class="s-t"></span>
        </span>
        <span>스폰지클럽</span>
      </a>
      <div class="nav-links">
        <a href="/board/">현황판</a>
        <a href="/keywords/">키워드</a>
        <a href="/skills/" aria-current="page">스킬모음</a>
        <a href="/gallery/">갤러리</a>
      </div>
    </div>
  </nav>

  <main class="wrap">
    <!-- ═══ SUMMARY HEADER ═══ -->
    <div class="skills-summary reveal d1">
      <div class="ss-label">PAGE OVERVIEW</div>
      <div class="ss-body">
        <p class="ss-lead">
          미션 노트에서 수집된 외부 링크 <strong>{links.length}개</strong> —
          멤버 77명이 공유한 스킬·도구·콘텐츠·산출물을 카테고리별로 정리했습니다.
        </p>
        <div class="ss-stats">
          <div class="ss-stat">
            <span class="ss-n">{skill.length}</span>
            <span class="ss-l">스킬·레포</span>
          </div>
          <div class="ss-stat">
            <span class="ss-n">{tool.length}</span>
            <span class="ss-l">도구·서비스</span>
          </div>
          <div class="ss-stat">
            <span class="ss-n">{content.length}</span>
            <span class="ss-l">콘텐츠·아티클</span>
          </div>
          <div class="ss-stat">
            <span class="ss-n">{showcase.length}</span>
            <span class="ss-l">멤버 산출물</span>
          </div>
        </div>
      </div>
    </div>

    <!-- page header -->
    <section class="s" style="padding-top: clamp(40px, 7vh, 72px);">
      <div class="s-head">
        <div>
          <div class="s-num">유용한 사이트 모음</div>
          <h1 class="s-title">스킬&nbsp;<em>&amp;</em>&nbsp;리소스</h1>
        </div>
        <p class="s-desc">
          77명의 멤버가 미션 과정에서 공유한 링크를 카테고리별로 모았습니다.
          총 <strong>{links.length}개</strong> 링크.
        </p>
      </div>

      <!-- category jump nav -->
      <div class="cat-tabs">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="cat-tab">
            <span class="ct-num">{s.num}</span>
            <span class="ct-label">{s.title}{s.titleEm}</span>
            <span class="ct-count">{s.items.length}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- category sections -->
    {sections.map((sec) => (
      <section class="s" id={sec.id}>
        <div class="s-head">
          <div>
            <div class="s-num">SECTION {sec.num}</div>
            <h2 class="s-title">{sec.title}<em>{sec.titleEm}</em></h2>
          </div>
          <p class="s-desc">{sec.desc}</p>
        </div>

        {sec.items.length === 0 ? (
          <div class="empty-note">아직 공유된 링크가 없습니다.</div>
        ) : (
          <div class="article-grid">
            {sec.items.map((link: SharedLink) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="article-card sk-card"
              >
                <div class="sk-host">
                  <span class="a-chip">{hostLabel(link.url)}</span>
                </div>
                <div class="a-title sk-title">{link.title}</div>
                <div class="sk-meta">
                  <span class="sk-sharers">
                    {link.sharedBy.slice(0, 4).join(' · ')}
                    {link.sharedBy.length > 4 && ` 외 ${link.sharedBy.length - 4}명`}
                  </span>
                </div>
                <div class="a-foot">
                  <span class="sk-weeks">
                    {link.weeks.map((w) => `${w}주차`).join(' · ')}
                  </span>
                  <span class="a-read">↗</span>
                </div>
              </a>
            ))}
          </div>
        )}
      </section>
    ))}

    <footer class="mag-footer">
      <div class="fo-bot">
        <span>스폰지클럽 — 매주 만들고, 각자 나눈다</span>
        <span>총 {links.length}개 링크</span>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* ─── SUMMARY HEADER ─────────────────────────── */
  .skills-summary {
    margin-top: clamp(32px, 5vh, 56px);
    background: var(--key);
    border: 4px solid var(--fg);
    box-shadow: var(--sh-l);
  }
  .ss-label {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: var(--fg);
    color: var(--white);
    padding: 7px 14px;
    display: inline-block;
  }
  .ss-body {
    padding: clamp(20px, 3vw, 36px) clamp(20px, 3vw, 36px) clamp(24px, 3.5vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .ss-lead {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.6vw, 18px);
    font-weight: 600;
    line-height: 1.6;
    color: var(--fg);
    max-width: 640px;
  }
  .ss-lead strong {
    font-family: var(--font-display);
    font-size: 1.1em;
    font-weight: 900;
    letter-spacing: -0.03em;
  }
  .ss-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 3px solid var(--fg);
    background: var(--white);
  }
  .ss-stat {
    padding: 18px 20px;
    border-right: 3px solid var(--fg);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ss-stat:last-child { border-right: none; }
  .ss-n {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--fg);
  }
  .ss-l {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg);
  }

  /* ─── category jump tabs ─────────────────────── */
  .cat-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .cat-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 2px solid var(--fg);
    background: var(--white);
    box-shadow: var(--sh-s);
    text-decoration: none;
    transition: transform 160ms ease-out, box-shadow 160ms ease-out, background 160ms ease-out;
  }
  .cat-tab:hover {
    background: var(--key);
    transform: translate(-2px, -2px);
    box-shadow: var(--sh-m);
  }
  .ct-num {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .ct-label {
    font-family: var(--font-label);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg);
  }
  .ct-count {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 900;
    color: var(--fg);
    background: var(--key);
    border: 2px solid var(--fg);
    padding: 1px 7px;
  }

  /* ─── skill card overrides ───────────────────── */
  .sk-card {
    text-decoration: none;
    min-height: 160px;
  }
  .sk-host {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .sk-title {
    font-size: clamp(14px, 1.4vw, 18px);
    line-height: 1.35;
  }
  .sk-meta {
    font-size: 12px;
    font-weight: 500;
    color: var(--fg);
    line-height: 1.5;
  }
  .sk-sharers {
    font-family: var(--font-label);
    font-size: 11px;
    font-weight: 600;
    color: var(--fg);
  }
  .sk-weeks {
    font-family: var(--font-label);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
  }

  /* ─── responsive summary ─────────────────────── */
  @media (max-width: 760px) {
    .ss-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .ss-stat:nth-child(2) { border-right: none; }
    .ss-stat:nth-child(1),
    .ss-stat:nth-child(2) { border-bottom: 3px solid var(--fg); }
  }
  @media (max-width: 480px) {
    .ss-stats {
      grid-template-columns: 1fr;
    }
    .ss-stat { border-right: none; border-bottom: 3px solid var(--fg); }
    .ss-stat:last-child { border-bottom: none; }
  }
</style>
