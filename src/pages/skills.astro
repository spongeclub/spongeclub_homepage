---
import Layout from '../layouts/Layout.astro';
import { loadCuratedSkills, type CuratedSkill, type CuratedQuote } from '../lib/curated-skills';

const skills = loadCuratedSkills();
const total = skills.length;
const reviewed = skills.filter((s) => s.postType === '써본후기').length;
const shared   = skills.filter((s) => s.postType === '공유').length;

// 후기 있는 카드 먼저, 그 안에서 userCount 큰 순
const sorted = [...skills].sort((a, b) => {
  const ar = a.postType === '써본후기' ? 1 : 0;
  const br = b.postType === '써본후기' ? 1 : 0;
  if (ar !== br) return br - ar;
  return (b.userCount || 0) - (a.userCount || 0);
});

// MVP = 가장 많이 써본 후기 1개 (userCount ≥ 2)
let mvpSlug: string | null = null;
const reviewCandidates = sorted.filter((s) => s.postType === '써본후기' && s.userCount >= 2);
if (reviewCandidates.length > 0) {
  mvpSlug = reviewCandidates.reduce((a, b) => (b.userCount > a.userCount ? b : a)).slug;
}

function tierOf(sk: CuratedSkill): 'mvp' | 'reviewed' | 'share' {
  if (sk.slug === mvpSlug) return 'mvp';
  if (sk.postType === '써본후기') return 'reviewed';
  return 'share';
}

// 두 섹션 — 떠오르는(써본후기, userCount 순) / 새로 들어온(나머지, 최근 등록순)
const trending = sorted.filter((s) => s.postType === '써본후기');
const fresh = [...skills]
  .filter((s) => s.postType !== '써본후기')
  .sort((a, b) => (b.created || '').localeCompare(a.created || ''));
const groups: { key: string; label: string; desc: string; list: CuratedSkill[] }[] = [
  { key: 'trending', label: '떠오르는 스킬', desc: `멤버들이 직접 써보고 남긴 후기 ${trending.length}개`, list: trending },
  { key: 'fresh', label: '새로 들어온 스킬', desc: `이번 주 새로 올라온 스킬 ${fresh.length}개`, list: fresh },
];

// 카테고리·난이도·게시 옵션
const CATEGORIES   = ['전체', '클로드코드', '콘텐츠마케팅', '개발도구', '생산성'] as const;
const DIFFICULTIES = ['설치만하면됨', '설정좀필요', '코드만져야함'] as const;
const POST_TYPES   = ['써본후기', '공유'] as const;

const CATEGORY_LABEL: Record<string, string> = {
  '전체': '전체',
  '클로드코드': '클로드코드',
  '콘텐츠마케팅': '콘텐츠·마케팅',
  '개발도구': '개발도구',
  '생산성': '생산성',
};

// 태그 컬러 — outline 스타일 (border + 옅은 bg + 진한 텍스트)
const COLOR_BY_CATEGORY: Record<string, { bd: string; bg: string; fg: string }> = {
  '클로드코드':   { bd: '#C9DCF7', bg: '#EAF2FF', fg: '#1F5BB8' },
  '콘텐츠마케팅': { bd: '#F1C9DA', bg: '#FBEBF1', fg: '#B03276' },
  '개발도구':     { bd: '#BFE0C8', bg: '#E8F5EC', fg: '#1F7A3A' },
  '생산성':       { bd: '#F0D9A8', bg: '#FCEFD2', fg: '#8E5D17' },
};
const COLOR_BY_DIFFICULTY: Record<string, { bd: string; bg: string; fg: string }> = {
  '설치만하면됨': { bd: '#BFE0C8', bg: '#E8F5EC', fg: '#1F7A3A' },
  '설정좀필요':   { bd: '#F0D9A8', bg: '#FCEFD2', fg: '#8E5D17' },
  '코드만져야함': { bd: '#F1C9C9', bg: '#FBEBEB', fg: '#B0322A' },
};
const COLOR_BY_POST: Record<string, { bd: string; bg: string; fg: string }> = {
  '써본후기': { bd: '#F1C9C9', bg: '#FBEBEB', fg: '#B0322A' },
  '공유':     { bd: '#ECE7DC', bg: '#FFFFFF', fg: '#4D4D4D' },
};

function topQuotes(q: CuratedQuote[]): CuratedQuote[] {
  return q.slice(0, 4);
}

function searchHaystack(sk: CuratedSkill): string {
  const parts = [
    sk.skillName,
    sk.title,
    sk.summary,
    sk.inspiredBy,
    sk.authors.join(' '),
    sk.audience.join(' '),
    sk.keywords.join(' '),
    sk.quotes.map((q) => `${q.quote} ${q.author}`).join(' '),
    sk.category,
    sk.difficulty,
    sk.postType,
  ];
  return parts.join(' ').toLowerCase();
}
---

<Layout title="스킬 & 인사이트 — 스폰지클럽" bodyClass="sk-body">
  <!-- ─── HEADER ─────────────────────────────────────── -->
  <header class="sk-header">
    <div class="sk-header-inner">
      <a href="/" class="sk-brand">
        <span class="sk-brand-mark">🧽</span>
        <span class="sk-brand-name">spongeclub</span>
        <span class="sk-brand-sep">/</span>
        <span class="sk-brand-sub">스킬 &amp; 인사이트</span>
      </a>
      <nav class="sk-nav" aria-label="메인 메뉴">
        <a href="/">매거진</a>
        <a href="/board/">현황판</a>
        <a href="/keywords/">키워드</a>
        <a href="/skills/" class="active">스킬</a>
        <a href="/gallery/">갤러리</a>
      </nav>
      <a class="sk-ext"
         href="https://spongeclub-community.vercel.app/"
         target="_blank" rel="noopener noreferrer">
        이기적인 스폰지들 <span aria-hidden="true">↗</span>
      </a>
    </div>
  </header>

  <!-- ─── MAIN ───────────────────────────────────────── -->
  <main class="sk-main">

    <!-- TITLE -->
    <section class="sk-title">
      <p class="sk-kicker">스폰지클럽 1기 · 데굴데굴 큐레이션</p>
      <h1 class="sk-h1">
        <span class="sk-shape sk-shape--triangle" aria-hidden="true"></span>
        스킬 &amp; 인사이트
      </h1>
      <p class="sk-lede">
        스폰지들이 직접 써본 스킬과 가이드.
        <span class="sk-highlight">"누가 발견 → 누가 써봄"</span> 흐름까지 같이 봐요.
      </p>
      <div class="sk-stats">
        <span><b>{total}</b>개 스킬</span>
        <span class="sk-sep">·</span>
        <span>써본후기 <b>{reviewed}</b>건</span>
        <span class="sk-sep">·</span>
        <span>공유 <b>{shared}</b>건</span>
        <span class="sk-sep">·</span>
        <span>표시 중 <b id="sk-visible">{total}</b>개</span>
      </div>
    </section>

    <!-- FILTER -->
    <section class="sk-filter" aria-label="필터">
      <div class="sk-filter-row sk-search-row">
        <span class="sk-filter-label">검색</span>
        <div class="sk-search-wrap">
          <input
            type="search"
            id="sk-search"
            class="sk-search"
            placeholder="스킬명·요약·키워드·후기·사람으로 찾기"
            autocomplete="off"
            aria-label="스킬 검색"
          />
          <button type="button" id="sk-search-clear" class="sk-search-clear" aria-label="검색 지우기" hidden>×</button>
        </div>
      </div>

      <div class="sk-filter-row">
        <span class="sk-filter-label">분야</span>
        {CATEGORIES.map((c) => (
          <button
            type="button"
            class="sk-chip"
            data-filter="category"
            data-value={c}
            data-active={c === '전체' ? 'true' : 'false'}
          >
            {CATEGORY_LABEL[c]}
          </button>
        ))}
      </div>

      <div class="sk-filter-row">
        <span class="sk-filter-label">난이도</span>
        <button type="button" class="sk-chip" data-filter="difficulty" data-value="전체" data-active="true">전체</button>
        {DIFFICULTIES.map((d) => (
          <button type="button" class="sk-chip" data-filter="difficulty" data-value={d} data-active="false">{d}</button>
        ))}
      </div>

      <div class="sk-filter-row">
        <span class="sk-filter-label">게시</span>
        <button type="button" class="sk-chip" data-filter="postType" data-value="전체" data-active="true">전체</button>
        {POST_TYPES.map((p) => (
          <button type="button" class="sk-chip" data-filter="postType" data-value={p} data-active="false">{p}</button>
        ))}
      </div>
    </section>

    <!-- GRID -->
    <section class="sk-grid" id="sk-grid">
      {groups.map((group) => (
        <Fragment>
          <h2 class="sk-grid-head" data-section-head={group.key} style="grid-column:1/-1">
            <span class="sk-grid-head-title">{group.label}</span>
            <span class="sk-grid-head-desc">{group.desc}</span>
          </h2>
          {group.list.map((sk: CuratedSkill) => {
        const catColor  = COLOR_BY_CATEGORY[sk.category]   ?? { bd: '#ECE7DC', bg: '#FFFFFF', fg: '#4D4D4D' };
        const diffColor = COLOR_BY_DIFFICULTY[sk.difficulty] ?? { bd: '#ECE7DC', bg: '#FFFFFF', fg: '#4D4D4D' };
        const postColor = COLOR_BY_POST[sk.postType] ?? { bd: '#ECE7DC', bg: '#FFFFFF', fg: '#4D4D4D' };
        const quotes    = topQuotes(sk.quotes);
        const isReview  = sk.postType === '써본후기';
        const tier      = tierOf(sk);
        const href      = sk.links[0];
        return (
          <article
            class={`sk-card sk-card--${tier}`}
            id={sk.slug}
            role="button"
            tabindex="0"
            aria-expanded="false"
            data-category={sk.category}
            data-difficulty={sk.difficulty}
            data-post-type={sk.postType}
            data-section={group.key}
            data-search={searchHaystack(sk)}
          >
            {tier === 'mvp' && (
              <span class="sk-card-badge">이번 주 가장 많이 써본 스킬</span>
            )}

            <div class="sk-card-row">
              <div class="sk-card-main">
                <p class="sk-card-name">{sk.skillName || sk.slug}</p>
                <h2 class="sk-card-title">{sk.summary || sk.skillName || sk.title}</h2>
                <div class="sk-tags">
                  {sk.category && (
                    <span class="sk-tag" style={`border-color:${catColor.bd};background:${catColor.bg};color:${catColor.fg}`}>
                      {CATEGORY_LABEL[sk.category] ?? sk.category}
                    </span>
                  )}
                  {sk.difficulty && (
                    <span class="sk-tag" style={`border-color:${diffColor.bd};background:${diffColor.bg};color:${diffColor.fg}`}>
                      {sk.difficulty}
                    </span>
                  )}
                  {sk.postType && (
                    <span class="sk-tag" style={`border-color:${postColor.bd};background:${postColor.bg};color:${postColor.fg}`}>
                      {sk.postType}
                    </span>
                  )}
                </div>
              </div>

              {sk.userCount > 0 && (
                <div class={`sk-card-fire sk-card-fire--${tier}`} aria-label={`${sk.userCount}명 사용`}>
                  <span class="sk-fire-emoji" aria-hidden="true">🔥</span>
                  <b class="sk-fire-num">{sk.userCount}</b>
                  <span class="sk-fire-label">명이 써봄</span>
                </div>
              )}

              <span class="sk-card-chevron" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 6l4 4 4-4"/>
                </svg>
              </span>
            </div>

            <div class="sk-card-detail">
              {sk.mainHtml && (
                <div class="sk-detail-block">
                  <p class="sk-detail-label">📝 주요 내용</p>
                  <div class="sk-detail-main" set:html={sk.mainHtml}></div>
                </div>
              )}

              {isReview && quotes.length > 0 && (
                <div class="sk-detail-block">
                  <p class="sk-detail-label">💬 써본 사람들이 발견한 것</p>
                  {quotes.map((q) => (
                    <blockquote class="sk-quote">
                      <p class="sk-quote-text">{q.quote}</p>
                      {q.author && <cite class="sk-quote-author">— {q.author}</cite>}
                    </blockquote>
                  ))}
                </div>
              )}

              {sk.inspiredBy && (
                <div class="sk-detail-flow">
                  <span aria-hidden="true">↻</span> {sk.inspiredBy}
                </div>
              )}

              {sk.authors.length > 0 && (
                <div class="sk-detail-block">
                  <p class="sk-detail-label">써본 사람들</p>
                  <div class="sk-author-chips">
                    {sk.authors.map((a) => (
                      <span class="sk-author-chip">{a}</span>
                    ))}
                  </div>
                </div>
              )}

              {(sk.githubUrl || sk.slackUrl || href) && (
                <div class="sk-detail-cta">
                  {sk.githubUrl && (
                    <a class="sk-detail-btn sk-detail-btn--dark" href={sk.githubUrl} target="_blank" rel="noopener noreferrer">
                      GitHub에서 보기 ↗
                    </a>
                  )}
                  {sk.slackUrl && (
                    <a class="sk-detail-btn sk-detail-btn--outline" href={sk.slackUrl} target="_blank" rel="noopener noreferrer">
                      슬랙 원본 보기 ↗
                    </a>
                  )}
                  {!sk.githubUrl && !sk.slackUrl && href && (
                    <a class="sk-detail-btn sk-detail-btn--outline" href={href} target="_blank" rel="noopener noreferrer">
                      원문 보기 ↗
                    </a>
                  )}
                </div>
              )}
            </div>
          </article>
        );
          })}
        </Fragment>
      ))}
    </section>

    <div id="sk-empty" class="sk-empty" hidden>해당 조건의 스킬이 없습니다.</div>

    <!-- DARK CTA — 한 페이지 1개 (절제된 임팩트) -->
    <section class="sk-cta">
      <p class="sk-cta-head">스킬을 발견했나요?</p>
      <p class="sk-cta-body">
        슬랙 <code>#이기적인-스킬러들</code> 채널에서 한 줄 공유 → 자동으로 이곳에 모입니다.
      </p>
      <a class="sk-cta-btn" href="https://spongeclub-community.vercel.app/" target="_blank" rel="noopener noreferrer">
        커뮤니티 열기 →
      </a>
    </section>

    <footer class="sk-footer">
      스폰지클럽 1기 · 스킬 &amp; 인사이트 · 데굴데굴 큐레이션
    </footer>
  </main>
</Layout>

<script is:inline>
  (function () {
    // ─── 필터 ──────────────────────────────────────
    var state = { category: '전체', difficulty: '전체', postType: '전체', query: '' };
    var cards = document.querySelectorAll('.sk-card');
    var visibleEl = document.getElementById('sk-visible');
    var emptyEl   = document.getElementById('sk-empty');
    var searchEl  = document.getElementById('sk-search');
    var clearEl   = document.getElementById('sk-search-clear');

    function tokens(q) {
      return q.toLowerCase().split(/\s+/).filter(function (t) { return t.length > 0; });
    }

    var sectionHeads = document.querySelectorAll('[data-section-head]');
    function apply() {
      var n = 0;
      var qTokens = tokens(state.query);
      var perSection = {};
      cards.forEach(function (card) {
        var c = card.getAttribute('data-category') || '';
        var d = card.getAttribute('data-difficulty') || '';
        var p = card.getAttribute('data-post-type') || '';
        var hay = card.getAttribute('data-search') || '';
        var queryMatch = qTokens.length === 0 || qTokens.every(function (t) { return hay.indexOf(t) !== -1; });
        var pass =
          (state.category === '전체' || c === state.category) &&
          (state.difficulty === '전체' || d === state.difficulty) &&
          (state.postType === '전체' || p === state.postType) &&
          queryMatch;
        card.hidden = !pass;
        if (pass) {
          n++;
          var sec = card.getAttribute('data-section') || '';
          perSection[sec] = (perSection[sec] || 0) + 1;
        }
      });
      // 필터 활성 시 섹션 헤더를 숨겨 통합 그리드로. 평소엔 빈 섹션만 숨김.
      var filtering = state.category !== '전체' || state.difficulty !== '전체' ||
                      state.postType !== '전체' || state.query !== '';
      sectionHeads.forEach(function (h) {
        var key = h.getAttribute('data-section-head') || '';
        h.hidden = filtering || !(perSection[key] > 0);
      });
      if (visibleEl) visibleEl.textContent = String(n);
      if (emptyEl) emptyEl.hidden = n !== 0;
      if (clearEl) clearEl.hidden = state.query.length === 0;
    }

    document.querySelectorAll('[data-filter]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var filter = btn.getAttribute('data-filter');
        var value  = btn.getAttribute('data-value');
        if (!filter || !value) return;
        state[filter] = value;
        document.querySelectorAll('[data-filter="' + filter + '"]').forEach(function (b) {
          b.setAttribute('data-active', b.getAttribute('data-value') === value ? 'true' : 'false');
        });
        apply();
      });
    });

    if (searchEl) {
      var composing = false;
      searchEl.addEventListener('compositionstart', function () { composing = true; });
      searchEl.addEventListener('compositionend', function () {
        composing = false;
        state.query = searchEl.value;
        apply();
      });
      searchEl.addEventListener('input', function () {
        if (composing) return;
        state.query = searchEl.value;
        apply();
      });
      searchEl.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && searchEl.value) {
          searchEl.value = '';
          state.query = '';
          apply();
          e.preventDefault();
        }
      });
    }
    if (clearEl) {
      clearEl.addEventListener('click', function () {
        if (!searchEl) return;
        searchEl.value = '';
        state.query = '';
        searchEl.focus();
        apply();
      });
    }

    // ─── 카드 클릭 → 펼치기/접기 ──────────────────
    function toggleCard(card) {
      var open = card.getAttribute('aria-expanded') === 'true';
      card.setAttribute('aria-expanded', open ? 'false' : 'true');
    }
    cards.forEach(function (card) {
      card.addEventListener('click', function (e) {
        // 내부 링크 클릭은 토글하지 않음
        var target = e.target;
        while (target && target !== card) {
          if (target.tagName === 'A') return;
          target = target.parentNode;
        }
        toggleCard(card);
      });
      card.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggleCard(card);
        }
      });
    });
  })();
</script>

<style is:global>
  /* ─── 스폰지클럽 디자인 시스템: /skills 페이지 (sk-*) ─── */

  body.sk-body {
    margin: 0;
    min-height: 100vh;
    background: var(--sc-bg-base);
    color: var(--sc-text-primary);
    font-family: var(--sc-font-body);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.005em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  body.sk-body * { box-sizing: border-box; }
  body.sk-body h1, body.sk-body h2, body.sk-body h3, body.sk-body p { margin: 0; }
  body.sk-body a { color: inherit; text-decoration: none; }
  body.sk-body button {
    font: inherit; color: inherit;
    background: none; border: none; cursor: pointer;
  }

  /* ─── HEADER ─── */
  .sk-header {
    position: sticky; top: 0; z-index: 30;
    background: var(--sc-bg-base);
    border-bottom: 1px solid var(--sc-border-soft);
  }
  .sk-header-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
    display: flex; align-items: center; gap: 24px;
  }
  .sk-brand {
    display: inline-flex; align-items: baseline; gap: 8px;
    flex-shrink: 0;
  }
  .sk-brand-mark { font-size: 20px; line-height: 1; }
  .sk-brand-name {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--sc-text-primary);
  }
  .sk-brand-sep { color: var(--sc-text-muted-low); }
  .sk-brand-sub {
    font-size: 13px;
    color: var(--sc-text-muted-high);
    font-weight: 500;
  }
  .sk-nav {
    display: flex; align-items: center; gap: 20px;
    margin-left: auto;
    font-size: 14px;
    font-weight: 500;
  }
  .sk-nav a {
    color: var(--sc-text-muted-mid);
    transition: color 160ms;
  }
  .sk-nav a:hover { color: var(--sc-text-primary); }
  .sk-nav a.active { color: var(--sc-text-primary); font-weight: 700; }
  .sk-ext {
    font-size: 13px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: var(--sc-radius-pill);
    background: var(--sc-bg-signature);
    color: var(--sc-text-primary);
    flex-shrink: 0;
    transition: filter 160ms;
  }
  .sk-ext:hover { filter: brightness(0.96); }
