---
import { marked } from 'marked';
import Layout from '../../../../layouts/Layout.astro';
import {
  buildAllWeeks,
  readSubmissionMarkdown,
  vaultGithubUrl,
  type Submission,
  type WeekData,
} from '../../../../lib/data';
import { getMemberAnalysis } from '../../../../lib/analysis';

export async function getStaticPaths() {
  const weeks = buildAllWeeks();
  const paths: any[] = [];
  for (const w of weeks) {
    for (const s of w.submissions) {
      if (!s.filePath) continue;
      paths.push({
        params: {
          week: String(w.weekNumber),
          team: s.member.team,
          member: s.member.nickname,
        },
        props: { week: w, submission: s },
      });
    }
  }
  return paths;
}

interface Props {
  week: WeekData;
  submission: Submission;
}

const { week, submission } = Astro.props as Props;
const md = submission.filePath ? readSubmissionMarkdown(submission.filePath) : '';
const html = marked.parse(md, { async: false }) as string;
const githubUrl = submission.filePath ? vaultGithubUrl(submission.filePath) : '';
const memberAnalysis = getMemberAnalysis(submission.member.team, submission.member.nickname);

const statusLabel =
  submission.status === 'submitted'
    ? '제출 완료'
    : submission.status === 'drafting'
      ? '작성 중'
      : '미작성';

const weekLabel = (n: number) => `WEEK ${String(n).padStart(2, '0')}`;
---

<Layout
  title={`${submission.member.nickname} — ${week.weekNumber}주차 | 스폰지클럽`}
  bodyClass="sc-page"
>
  <header class="sc-header">
    <div class="sc-header-inner">
      <a href="/" class="sc-brand">
        <span class="sc-brand-mark">🧽</span>
        <span class="sc-brand-name">spongeclub</span>
        <span class="sc-brand-sep">/</span>
        <span class="sc-brand-sub">{weekLabel(week.weekNumber)} · {submission.member.nickname}</span>
      </a>
      <nav class="sc-nav" aria-label="메인 메뉴">
        <a href="/">매거진</a>
        <a href={`/issue/${week.weekNumber}/`}>이번 호</a>
        <a href="/board/">현황판</a>
        <a href="/keywords/">키워드</a>
        <a href="/skills/">스킬</a>
      </nav>
      <span class="sc-week-pill">{weekLabel(week.weekNumber)}</span>
    </div>
  </header>

  <main class="nt-main">
    <a href={`/issue/${week.weekNumber}/`} class="sc-back">← {weekLabel(week.weekNumber)} 호</a>

    <header class="nt-header">
      <div class="nt-meta">
        <span class="sc-shape sc-shape--circle" aria-hidden="true"></span>
        <span class="nt-team">{submission.member.team}</span>
        {submission.member.fullName !== submission.member.nickname && (
          <span class="nt-fullname">({submission.member.fullName})</span>
        )}
        <span class={`nt-status nt-status--${submission.status}`}>{statusLabel}</span>
      </div>
      <h1 class="nt-title">
        {submission.noteTitle ?? `${week.weekNumber}주차 — ${submission.member.nickname}`}
      </h1>
      <div class="nt-links">
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener" class="nt-link">GitHub에서 원본 보기 ↗</a>
        )}
        {memberAnalysis && (
          <a href={`/member/${encodeURIComponent(submission.member.team)}/${encodeURIComponent(submission.member.nickname)}/`} class="nt-link">전체 성장기록 →</a>
        )}
      </div>
    </header>

    <article class="nt-content">
      <Fragment set:html={html} />
    </article>
  </main>

  <footer class="sc-footer">
    스폰지클럽 · {submission.member.nickname} · {weekLabel(week.weekNumber)}
  </footer>
</Layout>

<style is:global>
  .nt-main {
    max-width: 820px;
    margin: 0 auto;
    padding: 32px 24px 80px;
    display: flex; flex-direction: column; gap: 28px;
  }

  .nt-header {
    padding-bottom: 28px;
    border-bottom: 1px solid var(--sc-border-soft);
    display: flex; flex-direction: column; gap: 14px;
  }
  .nt-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .nt-meta .sc-shape { width: 18px; height: 18px; border-radius: var(--sc-radius-pill); margin-bottom: 0; }
  .nt-team {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: var(--sc-radius-pill);
    background: var(--sc-accent-blue);
    color: var(--sc-surface-white);
  }
  .nt-fullname { font-size: 13px; color: var(--sc-text-muted-mid); }
  .nt-status {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--sc-radius-pill);
    letter-spacing: 0.04em;
  }
  .nt-status--submitted { background: rgba(31, 122, 58, 0.12); color: #1F7A3A; }
  .nt-status--drafting { background: rgba(255, 226, 0, 0.30); color: #6B4410; }
  .nt-status--empty { background: var(--sc-border-soft); color: var(--sc-text-muted-mid); }

  .nt-title {
    font-family: var(--sc-font-display);
    font-weight: 400;
    font-size: clamp(34px, 4.4vw, 52px);
    line-height: 1.12;
    color: var(--sc-text-primary);
    letter-spacing: -0.015em;
  }
  .nt-links { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 4px; }
  .nt-link {
    font-size: 12px;
    font-weight: 600;
    color: var(--sc-accent-blue);
    border-bottom: 1px dashed var(--sc-accent-blue);
    padding-bottom: 1px;
  }
  .nt-link:hover { color: var(--sc-text-primary); border-bottom-color: var(--sc-text-primary); }

  /* markdown content */
  .nt-content {
    font-family: var(--sc-font-body);
    color: var(--sc-text-primary);
    line-height: 1.78;
    font-size: 16px;
  }
  .nt-content h1, .nt-content h2, .nt-content h3, .nt-content h4 {
    font-family: var(--sc-font-display);
    font-weight: 400;
    color: var(--sc-text-primary);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .nt-content h1 { font-size: 32px; margin: 2.2rem 0 1rem; }
  .nt-content h2 {
    font-size: 26px;
    margin: 2rem 0 0.9rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--sc-border-soft);
  }
  .nt-content h3 { font-size: 21px; margin: 1.5rem 0 0.6rem; }
  .nt-content h4 { font-size: 17px; margin: 1.2rem 0 0.5rem; font-family: var(--sc-font-body); font-weight: 700; }
  .nt-content p { margin: 0.85rem 0; }
  .nt-content ul, .nt-content ol { margin: 0.85rem 0; padding-left: 1.5rem; }
  .nt-content ul { list-style: disc; }
  .nt-content ol { list-style: decimal; }
  .nt-content li { margin: 0.25rem 0; }
  .nt-content a {
    color: var(--sc-accent-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  .nt-content a:hover { color: var(--sc-text-primary); }
  .nt-content code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    background: var(--sc-border-soft);
    padding: 0.12rem 0.4rem;
    border-radius: 6px;
    font-size: 0.9em;
    color: var(--sc-text-primary);
  }
  .nt-content pre {
    background: var(--sc-surface-dark);
    color: rgba(255, 251, 237, 0.94);
    padding: 1rem 1.25rem;
    border-radius: var(--sc-radius-card);
    overflow-x: auto;
    margin: 1.2rem 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .nt-content pre code { background: transparent; padding: 0; color: inherit; }
  .nt-content blockquote {
    border-left: 4px solid var(--sc-accent-yellow);
    padding: 0.4rem 1rem;
    margin: 1.2rem 0;
    background: rgba(255, 230, 122, 0.20);
    color: var(--sc-text-primary);
    border-radius: 0 8px 8px 0;
  }
  .nt-content hr {
    border: none;
    border-top: 1px solid var(--sc-border-soft);
    margin: 2.4rem 0;
  }
  .nt-content img {
    max-width: 100%;
    border-radius: var(--sc-radius-card);
    margin: 1.4rem 0;
  }
  .nt-content table {
    border-collapse: collapse;
    margin: 1.4rem 0;
    font-size: 14px;
    width: 100%;
  }
  .nt-content th, .nt-content td {
    border: 1px solid var(--sc-border-card);
    padding: 0.6rem 0.8rem;
    text-align: left;
  }
  .nt-content th { background: var(--sc-bg-signature); font-weight: 700; }
  .nt-content strong { font-weight: 700; color: var(--sc-text-primary); }
</style>
